<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --font-display: 'Bebas Neue', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
        body {
            background: var(--black);
            color: var(--white);
            font-family: var(--font-body);
            font-size: 16px;
            line-height: 1.6;
            min-height: 100vh;
        }

        nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            height: 64px;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
        }
        .nav-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .nav-wordmark { font-family: var(--font-display); font-size: 22px; letter-spacing: 0.06em; color: var(--white); line-height: 1; }
        .nav-wordmark span { color: var(--red); display: block; font-size: 11px; letter-spacing: 0.25em; font-family: var(--font-body); font-weight: 500; margin-top: 1px; }
        .nav-back {
            display: flex; align-items: center; gap: 8px;
            color: var(--silver-dim); text-decoration: none;
            font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
            transition: color 0.2s;
        }
        .nav-back:hover { color: var(--white); }
        .nav-back svg { width: 16px; height: 16px; stroke: currentColor; }

        .shell {
            max-width: 640px;
            margin: 0 auto;
            padding: 140px 24px 100px;
        }

        .page-eyebrow {
            font-size: 11px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase;
            color: var(--red); margin-bottom: 10px;
        }
        .page-title {
            font-family: var(--font-display);
            font-size: clamp(36px, 4vw, 52px);
            letter-spacing: 0.03em;
            line-height: 0.95;
            color: var(--white);
            margin-bottom: 16px;
        }
        .red-rule { width: 48px; height: 3px; background: var(--red); margin-bottom: 40px; }

        .flash {
            padding: 14px 16px;
            border-radius: 2px;
            font-size: 13.5px;
            margin-bottom: 24px;
        }
        .flash-success { background: rgba(74, 222, 128, 0.1); border: 1px solid rgba(74, 222, 128, 0.3); color: #4ADE80; }
        .flash-error { background: rgba(232, 57, 77, 0.1); border: 1px solid rgba(232, 57, 77, 0.3); color: #E8394D; }

        .panel {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 2px;
            padding: 32px;
            margin-bottom: 24px;
        }
        .panel-title {
            font-family: var(--font-display);
            font-size: 22px;
            letter-spacing: 0.04em;
            color: var(--white);
            margin-bottom: 6px;
        }
        .panel-sub {
            font-size: 13px;
            color: var(--silver-dim);
            margin-bottom: 24px;
        }

        .field-group { display: grid; gap: 18px; margin-bottom: 20px; }
        .field { display: flex; flex-direction: column; gap: 7px; }
        .field label {
            font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
            color: var(--silver-dim);
        }
        .field input {
            background: var(--card2);
            border: 1px solid var(--border);
            border-radius: 2px;
            color: var(--white);
            font-family: var(--font-body);
            font-size: 15px;
            padding: 13px 15px;
            outline: none;
            transition: border-color 0.2s;
        }
        .field input:focus { border-color: rgba(200, 16, 46, 0.5); }
        .field-hint { font-size: 12px; color: var(--silver-dim); }

        .btn-primary {
            display: inline-flex; align-items: center; gap: 10px;
            background: var(--red); color: var(--white); border: none;
            font-family: var(--font-body); font-size: 13px; font-weight: 600;
            letter-spacing: 0.12em; text-transform: uppercase;
            padding: 14px 28px; border-radius: 2px; cursor: pointer;
            transition: background 0.2s;
        }
        .btn-primary:hover { background: var(--red-dark); }

        .role-pill {
            display: inline-block;
            font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
            padding: 4px 10px; border-radius: 100px;
            background: rgba(200, 16, 46, 0.12);
            color: var(--red);
            border: 1px solid rgba(200, 16, 46, 0.3);
        }

        .admin-placeholder {
            color: var(--silver-dim);
            font-size: 13.5px;
            padding: 20px;
            text-align: center;
            border: 1px dashed var(--border);
            border-radius: 2px;
        }

        .admin-tools-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 20px;
        }
        .admin-tool-tile {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 8px;
            padding: 20px 14px;
            min-height: 110px;
            background: var(--card2);
            border: 1px solid var(--border);
            border-radius: 2px;
            text-decoration: none;
            color: var(--white);
            transition: border-color 0.15s, background 0.15s;
        }
        .admin-tool-tile:hover {
            border-color: rgba(200, 16, 46, 0.4);
            background: var(--card);
        }
        .admin-tool-icon {
            width: 30px;
            height: 30px;
            stroke: var(--red);
        }
        .admin-tool-icon svg { width: 100%; height: 100%; }
        .admin-tool-name {
            font-size: 13.5px;
            font-weight: 600;
        }
        .admin-tool-desc {
            font-size: 11.5px;
            color: var(--silver-dim);
        }
        .admin-tool-placeholder {
            opacity: 0.45;
            cursor: not-allowed;
        }

        @media (max-width: 560px) {
            .admin-tools-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 640px) {
            nav { padding: 0 20px; }
            .shell { padding: 110px 20px 60px; }
            .panel { padding: 24px; }
        }
    </style>
</head>
<body>
    <nav>
        <a href="/" class="nav-logo">
            <svg width="36" height="36" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="20,2 38,36 2,36" fill="none" stroke="#C8102E" stroke-width="2.5" />
                <text x="20" y="32" text-anchor="middle" font-family="'Bebas Neue',sans-serif" font-size="18" fill="#C0C0C0">TA</text>
            </svg>
            <div class="nav-wordmark">Triangle<span>Auto Works</span></div>
        </a>
        <a href="/" class="nav-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Back to Site
        </a>
    </nav>

    <div class="shell">
        <div class="page-eyebrow">Account</div>
        <h1 class="page-title">Settings</h1>
        <div class="red-rule"></div>

            <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length) { %>
            <% successMessage.forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
            <% }) %>
            <% } %>
            <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length) { %>
                <% errorMessage.forEach(function(msg) { %>
                    <div class="flash flash-error"><%= msg %></div>
                <% }) %>
            <% } %>
            <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
                <% errors.forEach(function(err) { %>
                    <div class="flash flash-error"><%= err.message %></div>
                <% }) %>
            <% } %>

            <div class="panel">
            <div class="panel-title">Profile</div>
            <div class="panel-sub">
                <span class="role-pill">
                    <%= user.role >= 3 ? 'Owner' : user.role === 2 ? 'Staff' : 'Customer' %>
                </span>
            </div>
            <form method="POST" action="/updateProfile">
                <div class="field-group">
                    <div class="field">
                        <label>Name</label>
                        <input type="text" name="name" value="<%= user.name %>" required minlength="3">
                    </div>
                    <div class="field">
                        <label>Email</label>
                        <input type="email" name="email" value="<%= user.email %>" required>
                    </div>
                    <div class="field">
                        <label>Phone</label>
                        <input type="tel" name="phone" value="<%= user.phone %>" required minlength="10">
                    </div>
                </div>
                <button type="submit" class="btn-primary">Save Changes</button>
            </form>
        </div>

        <div class="panel">
            <div class="panel-title">Password</div>
            <div class="panel-sub">Change the password used to sign in.</div>
            <form method="POST" action="/changePassword">
                <div class="field-group">
                    <div class="field">
                        <label>Current Password</label>
                        <input type="password" name="currentPassword" required>
                    </div>
                    <div class="field">
                        <label>New Password</label>
                        <input type="password" name="newPassword" required minlength="6">
                        <div class="field-hint">At least 6 characters.</div>
                    </div>
                    <div class="field">
                        <label>Confirm New Password</label>
                        <input type="password" name="confirmPassword" required minlength="6">
                    </div>
                </div>
                <button type="submit" class="btn-primary">Update Password</button>
            </form>
        </div>

        <div class="settings-card">
            <h3>Passkeys</h3>
            <p>Sign in without a password using Face ID, Touch ID, or a security key.</p>
            <div id="passkeyList"></div>
            <button type="button" id="addPasskeyBtn" class="btn-primary">Add a Passkey</button>
        </div>

        <% if (user.role >= 2) { %>
            <div class="panel">
                <div class="panel-title">Admin</div>
                <div class="panel-sub">
                    Tools for staff and management.
                    <a href="/admin" style="color: var(--red); margin-left: 6px;">Open full dashboard →</a>
                </div>
                <div class="admin-tools-grid">
                    <a href="/admin/bookings" class="admin-tool-tile">
                        <div class="admin-tool-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                        <div class="admin-tool-name">Bookings</div>
                        <div class="admin-tool-desc">Manage customer requests</div>
                    </a>
                    <a href="/admin/users" class="admin-tool-tile">
                        <div class="admin-tool-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users-round-icon lucide-users-round"><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/></svg>
                        </div>
                        <div class="admin-tool-name">Users</div>
                        <div class="admin-tool-desc">Manage staff and customer accounts</div>
                    </a>
                    <a href="/admin/site" class="admin-tool-tile">
                        <div class="admin-tool-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14a1 1 0 0 0 1-1v-4.5a1 1 0 0 0-.4-.8L16.5 8H15l-1.5-3H9L7.5 8H6.4a1 1 0 0 0-.8.4L3.4 11A1 1 0 0 0 3 11.8V16a1 1 0 0 0 1 1Z"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/></svg>
                        </div>
                        <div class="admin-tool-name">Site</div>
                        <div class="admin-tool-desc">Vehicles, parts & more</div>
                    </a>
                </div>
            </div>
        <% } %>
    </div>

    <script src="/js/vendor/simplewebauthn-browser.js"></script>
    <script src="/js/passkey-settings.js"></script>
</body>
</html>
