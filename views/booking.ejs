<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book a Service — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/booking.css">
</head>

<body>

    <nav>
        <a href="/" class="nav-logo">
            <svg width="36" height="36" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"
                style="margin-right:0">
                <polygon points="20,2 38,36 2,36" fill="none" stroke="#C8102E" stroke-width="2.5" />
                <text x="20" y="32" text-anchor="middle" font-family="'Bebas Neue',sans-serif" font-size="18"
                    fill="#C0C0C0">TA</text>
            </svg>
            <div class="nav-wordmark" style="margin-left:10px">
                Triangle
                <span>Auto Works</span>
            </div>
        </a>
        <a href="/" class="nav-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Back to Site
        </a>
    </nav>

    <div class="booking-layout">

        <!-- MAIN -->
        <div class="booking-main">

            <!-- PROGRESS -->
            <div class="progress-bar" id="progressBar">
                <div class="progress-step active" data-step="1" onclick="jumpToStep(1)">
                    <div class="progress-step-num">1</div>
                    <div class="progress-step-label">Vehicle</div>
                </div>
                <div class="progress-connector" id="conn-1"></div>
                <div class="progress-step" data-step="2" onclick="jumpToStep(2)">
                    <div class="progress-step-num">2</div>
                    <div class="progress-step-label">Service</div>
                </div>
                <div class="progress-connector" id="conn-2"></div>
                <div class="progress-step" data-step="3" onclick="jumpToStep(3)">
                    <div class="progress-step-num">3</div>
                    <div class="progress-step-label">Details</div>
                </div>
                <div class="progress-connector" id="conn-3"></div>
                <div class="progress-step" data-step="4" onclick="jumpToStep(4)">
                    <div class="progress-step-num">4</div>
                    <div class="progress-step-label">Logistics</div>
                </div>
                <div class="progress-connector" id="conn-4"></div>
                <div class="progress-step" data-step="5" onclick="jumpToStep(5)">
                    <div class="progress-step-num">5</div>
                    <div class="progress-step-label">Contact</div>
                </div>
                <div class="progress-connector" id="conn-5"></div>
                <div class="progress-step" data-step="6" onclick="jumpToStep(6)">
                    <div class="progress-step-num">6</div>
                    <div class="progress-step-label">Confirm</div>
                </div>
            </div>

            <!-- STEP 1: VEHICLE -->
            <div class="step-panel active" id="step-1">
                <div class="step-eyebrow">Step 1 of 6</div>
                <h2 class="step-title">Your Vehicle</h2>
                <div class="red-rule"></div>
                <% if (!user) { %>
                    <p class="multi-hint">Have an account? <a href="/login" style="color:var(--red)">Log in first</a> so this booking shows in your order history and you can review it afterwards.</p>
                <% } %>

                <div class="vin-toggle">
                    <button class="vin-tab active" onclick="switchVinTab('manual', this)">Year / Make / Model</button>
                    <button class="vin-tab" onclick="switchVinTab('vin', this)">Enter VIN</button>
                </div>

                <!-- Manual -->
                <div class="vin-section active" id="vin-manual">

                    <!-- MAKE PICKER -->
                    <div class="picker-stage" id="stage-make">
                        <div class="picker-stage-header">
                            <span class="picker-stage-label">Make</span>
                            <span class="picker-stage-selected" id="make-selected-label"></span>
                        </div>
                        <input class="picker-search" id="make-search" placeholder="Search makes…"
                            oninput="filterMakes(this.value)">
                        <div class="picker-grid" id="make-grid"></div>
                        <div class="picker-locked" id="make-locked" style="display:none">
                            <div>
                                <div class="picker-locked-val" id="make-locked-val"></div>
                            </div>
                            <button class="picker-change-btn" onclick="resetMake()">Change</button>
                        </div>
                        <div class="field-error" id="f-make-err" style="display:none;margin-top:8px">Please select a
                            make.</div>
                    </div>

                    <!-- MODEL PICKER -->
                    <div class="picker-stage disabled" id="stage-model">
                        <div class="picker-stage-header">
                            <span class="picker-stage-label">Model</span>
                            <span class="picker-stage-selected" id="model-selected-label"></span>
                        </div>
                        <input class="picker-search" id="model-search" placeholder="Search models…"
                            oninput="filterModels(this.value)">
                        <div class="picker-grid models-grid" id="model-grid"></div>
                        <div class="picker-locked" id="model-locked" style="display:none">
                            <div>
                                <div class="picker-locked-val" id="model-locked-val"></div>
                            </div>
                            <button class="picker-change-btn" onclick="resetModel()">Change</button>
                        </div>
                        <div class="field-error" id="f-model-err" style="display:none;margin-top:8px">Please select a
                            model.</div>
                    </div>

                    <!-- YEAR -->
                    <div class="picker-stage disabled" id="stage-year">

                        <div class="picker-stage-header">
                            <span class="picker-stage-label">Year</span>
                            <span class="picker-stage-selected" id="year-selected-label"></span>
                        </div>

                        <input class="picker-search" id="year-search" placeholder="Search years..."
                            oninput="filterYears(this.value)">

                        <div class="picker-grid" id="year-grid"></div>

                        <div class="field-error" id="f-year-err" style="display:none">
                            Please select a year.
                        </div>

                    </div>

                    <!-- Vehicle type/size is no longer asked: it comes from the
                         model's size in vehicle-data.js (Admin > Site > Vehicle Data). -->
                </div>

                <!-- VIN -->
                <div class="vin-section" id="vin-vin">
                    <div class="field-group cols-1">
                        <div class="field" id="f-vin">
                            <label>VIN Number</label>
                            <div class="vin-row">
                                <input type="text" id="vehicleVIN" maxlength="17" placeholder="Enter VIN"
                                    oninput="this.value=this.value.toUpperCase(); updateSidebar()">

                                <button type="button" class="btn-primary" onclick="lookupVIN()"
                                    style="margin-top: 15px;">
                                    Lookup VIN
                                </button>
                            </div>
                            <div id="vinLookupStatus"></div> <!-- loading/error messages only -->
                            <div id="vinDecodedCard" class="vin-decoded-card" style="display:none">
                                <h4>Vehicle Found</h4>
                                <div class="vin-grid">
                                    <div><span>Year</span><strong id="vinYear"></strong></div>
                                    <div><span>Make</span><strong id="vinMake"></strong></div>
                                    <div><span>Model</span><strong id="vinModel"></strong></div>
                                    <div><span>Engine</span><strong id="vinEngine"></strong></div>
                                </div>
                            </div>
                            <div class="field-hint">17-character Vehicle Identification Number — found on your dash,
                                door jamb, or registration.</div>
                            <div class="field-error">Please enter a valid 17-character VIN.</div>
                        </div>
                    </div>
                </div>

                <div class="step-nav">
                    <button class="btn-primary" onclick="nextStep(1)">
                        Continue
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- STEP 2: SERVICE CATEGORY -->
            <div class="step-panel" id="step-2">
                <div class="step-eyebrow">Step 2 of 6</div>
                <h2 class="step-title">Service Type</h2>
                <div class="red-rule"></div>

                <div class="category-grid">
                    <div class="category-card" onclick="selectCategory('Detailing', this)">
                        <svg viewBox="0 0 48 48" fill="none" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round">
                            <rect x="4" y="20" width="40" height="16" rx="3" />
                            <path d="M8 20 L14 10 L34 10 L40 20" />
                            <circle cx="13" cy="36" r="4" />
                            <circle cx="35" cy="36" r="4" />
                        </svg>
                        <div class="category-card-name">Detailing</div>
                        <div class="category-card-desc">Interior, exterior, ceramic coatings & paint decon</div>
                    </div>
                    <div class="category-card" onclick="selectCategory('Tint', this)">
                        <svg viewBox="0 0 48 48" fill="none" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round">
                            <rect x="6" y="12" width="36" height="22" rx="2" />
                            <line x1="6" y1="23" x2="42" y2="23" />
                            <path d="M14 34 L34 34 L36 40 L12 40 Z" />
                        </svg>
                        <div class="category-card-name">Tint</div>
                        <div class="category-card-desc">Standard, carbon, ceramic & windshield tinting</div>
                    </div>
                    <div class="category-card" onclick="selectCategory('Automotive', this)">
                        <svg viewBox="0 0 48 48" fill="none" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round">
                            <circle cx="24" cy="24" r="10" />
                            <circle cx="24" cy="24" r="4" />
                            <path d="M24 8v6 M24 34v6 M8 24h6 M34 24h6" />
                            <path d="M12 12l4.2 4.2 M31.8 31.8L36 36 M36 12l-4.2 4.2 M16.2 31.8L12 36" />
                        </svg>
                        <div class="category-card-name">Automotive</div>
                        <div class="category-card-desc">Oil changes, brakes, tires & diagnostics</div>
                    </div>
                </div>

                <div class="step-nav">
                    <button class="btn-ghost" onclick="prevStep(2)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        Back
                    </button>
                    <button class="btn-primary" onclick="nextStep(2)" id="btn-next-2">
                        Continue
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- STEP 3: SPECIFIC SERVICES -->
            <div class="step-panel" id="step-3">
                <div class="step-eyebrow">Step 3 of 6</div>
                <h2 class="step-title" id="step3-title">Choose Services</h2>
                <div class="red-rule"></div>
                <p class="multi-hint">Select all that apply — we'll handle them in one visit when possible.</p>
                <div class="service-options-grid" id="serviceOptionsGrid"></div>
                <div id="serviceConfigurator"></div>
                <div class="parts-estimate-card">

                    <div class="estimate-header" id="estimateHeader">
                        Estimated Parts
                    </div>

                    <div id="selectedPartsList">
                        No parts selected yet.
                    </div>

                    <div class="estimate-total">
                        <span id="estimateTotalLabel">Estimated Parts Total:</span>
                        <span id="partsEstimateTotal">$0.00</span>
                    </div>

                </div>

                <div class="step-nav">
                    <button class="btn-ghost" onclick="prevStep(3)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        Back
                    </button>
                    <button class="btn-primary" onclick="nextStep(3)">
                        Continue
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- STEP 4: LOGISTICS -->
            <div class="step-panel" id="step-4">
                <div class="step-eyebrow">Step 4 of 6</div>
                <h2 class="step-title">Logistics</h2>
                <div class="red-rule"></div>

                <div
                    style="margin-bottom:8px;font-size:11px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--silver-dim)">
                    Service Location</div>
                <div class="location-grid" style="margin-bottom:28px">
                    <div class="location-card" onclick="selectLocation('Home', this)">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"
                            stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                        <div class="location-card-label">Home</div>
                    </div>
                    <div class="location-card" onclick="selectLocation('Office / Work', this)">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"
                            stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" />
                            <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" />
                        </svg>
                        <div class="location-card-label">Office</div>
                    </div>
                    <div class="location-card" onclick="selectLocation('Other', this)">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"
                            stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        <div class="location-card-label">Other</div>
                    </div>
                </div>

                <div class="field-group cols-1" style="margin-bottom:20px">
                    <div class="field" id="f-address">
                        <label>Service Address</label>
                        <input type="text" id="serviceAddress" placeholder="Street address, city, zip"
                            oninput="updateSidebar()">
                        <div class="field-error">Please enter a service address.</div>
                    </div>
                </div>

                <div class="datetime-row">
                    <div class="field" id="f-date" style="margin-bottom: 24px;">
                        <label>Preferred Date</label>
                        <div class="calendar-wrap">
                            <div class="calendar-header">
                                <button type="button" class="calendar-nav-btn" id="calendarPrevBtn"
                                    aria-label="Previous month">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <polyline points="15 18 9 12 15 6" />
                                    </svg>
                                </button>
                                <span class="calendar-month-label" id="calendarMonthLabel"></span>
                                <button type="button" class="calendar-nav-btn" id="calendarNextBtn"
                                    aria-label="Next month">
                                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6" />
                                    </svg>
                                </button>
                            </div>
                            <div class="calendar-weekdays">
                                <div class="cal-weekday">S</div>
                                <div class="cal-weekday">M</div>
                                <div class="cal-weekday">T</div>
                                <div class="cal-weekday">W</div>
                                <div class="cal-weekday">T</div>
                                <div class="cal-weekday">F</div>
                                <div class="cal-weekday">S</div>
                            </div>
                            <div class="calendar-grid" id="calendarGrid"></div>
                            <div class="calendar-legend">
                                <div class="calendar-legend-item">
                                    <span class="calendar-legend-dot"></span>
                                    Limited availability
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="preferredDate">
                        <div class="field-error">Please select a preferred date.</div>
                    </div>

                    <div class="field-group cols-1" style="margin-bottom: 20px;">
                        <div class="field" id="f-time">
                            <label>Preferred Time</label>
                            <div class="time-pill-grid" id="timePillGrid"></div>
                            <!-- booking.js / submitBooking() reads preferredTime's value via
             document.getElementById('preferredTime').value — kept as a
             hidden input so nothing downstream has to change. -->
                            <input type="hidden" id="preferredTime">
                            <div class="field-error">Please select a preferred time.</div>
                        </div>
                    </div>
                </div>

                <div class="field-group cols-1">
                    <div class="field">
                        <label>First-Time Customer?</label>
                        <select id="firstTime" onchange="updateSidebar()">
                            <option value="">Select one</option>
                            <option value="yes">Yes — first time with Triangle Auto Works</option>
                            <option value="no">No — I've booked before</option>
                        </select>
                        <div class="field-hint">First-timers get exclusive discounts on select services.</div>
                    </div>
                </div>

                <div class="step-nav">
                    <button class="btn-ghost" onclick="prevStep(4)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        Back
                    </button>
                    <button class="btn-primary" onclick="nextStep(4)">
                        Continue
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- STEP 5: CONTACT + NOTES -->
            <div class="step-panel" id="step-5">
                <div class="step-eyebrow">Step 5 of 6</div>
                <h2 class="step-title">Contact Info</h2>
                <div class="red-rule"></div>

                <div class="field-group cols-2">
                    <div class="field" id="f-fname">
                        <label>First Name</label>
                        <input type="text" id="contactFirst" placeholder="First name" oninput="updateSidebar()">
                        <div class="field-error">First name is required.</div>
                    </div>
                    <div class="field" id="f-lname">
                        <label>Last Name</label>
                        <input type="text" id="contactLast" placeholder="Last name" oninput="updateSidebar()">
                        <div class="field-error">Last name is required.</div>
                    </div>
                </div>

                <div class="field-group cols-2">
                    <div class="field" id="f-phone">
                        <label>Phone / Text</label>
                        <input type="tel" id="contactPhone" placeholder="(555) 000-0000"
                            oninput="formatPhone(this); updateSidebar()">
                        <div class="field-hint">We'll confirm your appointment by text.</div>
                        <div class="field-error">Please enter a valid phone number.</div>
                    </div>
                    <div class="field" id="f-email">
                        <label>Email <span
                                style="color:var(--silver-dim);font-weight:400;text-transform:none;letter-spacing:0">(optional)</span></label>
                        <input type="email" id="contactEmail" placeholder="you@email.com" oninput="updateSidebar()">
                    </div>
                </div>

                <div class="field-group cols-1">
                    <div class="field">
                        <label>Anything else we should know? <span
                                style="color:var(--silver-dim);font-weight:400;text-transform:none;letter-spacing:0">(optional)</span></label>
                        <textarea id="contactNotes"
                            placeholder="Specific concerns, damage areas, access instructions, preferred products, prior work done on the vehicle…"
                            oninput="updateSidebar()"></textarea>
                    </div>
                </div>

                <div class="field-group cols-1">
                    <div class="field">
                        <label>How'd you hear about us? <span
                                style="color:var(--silver-dim);font-weight:400;text-transform:none;letter-spacing:0">(optional)</span></label>
                        <select id="hearAbout">
                            <option value="">Select one</option>
                            <option>Instagram (@triangleautoworks919)</option>
                            <option>Google Search</option>
                            <option>Friend / Word of Mouth</option>
                            <option>Flyer</option>
                            <option>Other</option>
                        </select>
                    </div>
                </div>

                <div class="step-nav">
                    <button class="btn-ghost" onclick="prevStep(5)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        Back
                    </button>
                    <button class="btn-primary" onclick="nextStep(5)">
                        Review Booking
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- STEP 6: CONFIRM -->
            <div class="step-panel" id="step-6">
                <div class="step-eyebrow">Step 6 of 6</div>
                <h2 class="step-title">Review &amp; Confirm</h2>
                <div class="red-rule"></div>

                <div id="invoicePreview" class="invoice-preview"></div>

                <!-- Discount code: one per booking, any service category. Wired up in discount.js -->
                <div class="discount-box" id="discountBox">
                    <label class="discount-label" for="discountCodeInput">Discount Code</label>
                    <div class="discount-row">
                        <input type="text" id="discountCodeInput" placeholder="Enter code" maxlength="24"
                            autocomplete="off" autocapitalize="characters" spellcheck="false">
                        <button type="button" class="btn-ghost" id="discountApplyBtn">Apply</button>
                        <button type="button" class="btn-ghost" id="discountRemoveBtn" style="display:none">Remove</button>
                    </div>
                    <div class="discount-status" id="discountStatus" aria-live="polite"></div>
                </div>

                <div class="confirm-summary" id="confirmSummary"></div>

                <p style="font-size:13px;color:var(--silver-dim);line-height:1.6;margin-bottom:28px">
                    Submitting this sends your request directly to our team. We'll reach out within a few hours to
                    confirm availability, finalize the appointment, and answer any questions.
                </p>

                <div class="field-error" id="submitError" style="display:none;margin-bottom:20px"></div>

                <div class="step-nav">
                    <button class="btn-ghost" onclick="prevStep(6)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                        Back
                    </button>
                    <button class="btn-primary" onclick="submitBooking()">
                        Confirm Booking
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- SUCCESS -->
            <div class="success-panel" id="step-success">
                <div class="success-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <h2 class="success-title">You're Booked.</h2>
                <p class="success-sub">We received your request and will text you shortly to confirm the time and
                    address. See you soon.</p>
                <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
                    <a href="/" class="btn-ghost">Back to Site</a>
                    <!-- <a href="tel:7326478703" class="btn-primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path
