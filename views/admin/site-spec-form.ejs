<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= spec ? 'Edit Spec' : 'New Spec' %> — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FAFAFA;
            --surface: #FFFFFF;
            --ink: #1D1D1F;
            --ink-soft: #6E6E73;
            --ink-faint: #AEAEB2;
            --line: rgba(0,0,0,0.07);
            --red: #C8102E;
            --red-soft: rgba(200,16,46,0.08);
            --blue: #0071E3;
            --green: #1E8E5A;
            --radius: 14px;
            --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }
        body {
            background: var(--bg);
            color: var(--ink);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(250,250,250,0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
        .topbar-back {
            display: flex; align-items: center; gap: 6px;
            color: var(--ink-soft); text-decoration: none;
            font-size: 13px; font-weight: 600; transition: color 0.15s;
        }
        .topbar-back:hover { color: var(--ink); }
        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }

        .shell {
            max-width: 640px;
            margin: 0 auto;
            padding: 40px 32px 100px;
        }

        .page-heading h1 {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }
        .page-sub {
            font-size: 13.5px;
            color: var(--ink-soft);
            margin-bottom: 24px;
        }

        .flash {
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 13.5px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .flash-success { background: rgba(30,142,90,0.08); border: 1px solid rgba(30,142,90,0.25); color: var(--green); }
        .flash-error { background: rgba(200,16,46,0.08); border: 1px solid rgba(200,16,46,0.25); color: var(--red); }

        .panel {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 28px;
            margin-bottom: 20px;
        }
        .panel-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 4px;
        }
        .panel-sub {
            font-size: 12.5px;
            color: var(--ink-soft);
            margin-bottom: 18px;
        }

        .field-group { display: grid; gap: 16px; }
        .field-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .field { display: flex; flex-direction: column; gap: 6px; }
        .field label {
            font-size: 12px; font-weight: 600;
            color: var(--ink-soft);
        }
        .field input, .field select, .field textarea {
            font-family: var(--font);
            font-size: 14.5px;
            padding: 10px 13px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--bg);
            outline: none;
            transition: border-color 0.15s;
            color: var(--ink);
        }
        .field textarea { resize: vertical; min-height: 80px; line-height: 1.5; }
        .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--blue); }
        .field-hint { font-size: 11.5px; color: var(--ink-faint); }

        .btn-row {
            display: flex;
            gap: 10px;
            margin-top: 24px;
        }
        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            font-family: var(--font); font-size: 13.5px; font-weight: 600;
            padding: 11px 22px; border-radius: 10px; cursor: pointer;
            border: none; transition: opacity 0.15s, background 0.15s;
            text-decoration: none;
        }
        .btn-primary { background: var(--ink); color: var(--surface); }
        .btn-primary:hover { opacity: 0.85; }
        .btn-secondary {
            background: var(--bg);
            color: var(--ink);
            border: 1px solid var(--line);
        }
        .btn-secondary:hover { background: rgba(0,0,0,0.03); }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/admin/site/specs" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Vehicle Specs
        </a>
        <div class="topbar-title">Triangle Auto Works — Admin</div>
        <div style="width:90px"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1><%= spec ? 'Edit Spec Entry' : 'New Spec Entry' %></h1>
        </div>
        <div class="page-sub">
            <% if (spec) { %>
                Editing <%= spec.make %> <%= spec.model %><%= spec.year ? ' ' + spec.year : ' (model default)' %>.
            <% } else { %>
                Leave year blank to set a model-level default that applies to all years unless a specific year has its own entry.
            <% } %>
        </div>

        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length) { %>
            <% successMessage.forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
            <% }) %>
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length) { %>
            <% errorMessage.forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
            <% }) %>
        <% } %>

        <form method="POST" action="<%= spec ? '/admin/site/specs/' + spec._id : '/admin/site/specs/new' %>">
            <div class="panel">
                <div class="panel-title">Vehicle</div>
                <div class="panel-sub">Which vehicle this spec applies to.</div>
                <div class="field-group">
                    <div class="field-row">
                        <div class="field">
                            <label>Make</label>
                            <select name="make" required <%= spec ? 'disabled' : '' %>>
                                <option value="">Select a make…</option>
                                <% Object.keys(vehicleData).sort().forEach(function(make) { %>
                                    <option value="<%= make %>" <%= (spec && spec.make === make) ? 'selected' : '' %>><%= make %></option>
                                <% }); %>
                            </select>
                            <% if (spec) { %>
                                <input type="hidden" name="make" value="<%= spec.make %>">
                                <div class="field-hint">Make/model can't be changed after creation — delete and re-create instead.</div>
                            <% } %>
                        </div>
                        <div class="field">
                            <label>Model</label>
                            <% if (spec) { %>
                                <input type="text" value="<%= spec.model %>" disabled>
                                <input type="hidden" name="model" value="<%= spec.model %>">
                            <% } else { %>
                                <input type="text" name="model" list="model-options" placeholder="Select make first, or type a model" required>
                                <datalist id="model-options"></datalist>
                            <% } %>
                        </div>
                    </div>
                    <div class="field">
                        <label>Year</label>
                        <input type="number" name="year" min="1900" max="2100" placeholder="Leave blank for model default" value="<%= spec && spec.year ? spec.year : '' %>" <%= spec ? 'disabled' : '' %>>
                        <% if (spec) { %>
                            <input type="hidden" name="year" value="<%= spec.year || '' %>">
                        <% } %>
                        <div class="field-hint">Leave blank for a model-wide default. A specific year fully overrides the default — it does not merge with it.</div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">Oil</div>
                <div class="field-group">
                    <div class="field-row">
                        <div class="field">
                            <label>Viscosity</label>
                            <input type="text" name="oilViscosity" placeholder="e.g. 5W-30" value="<%= spec && spec.oil && spec.oil.viscosity ? spec.oil.viscosity : '' %>">
                        </div>
                        <div class="field">
                            <label>Capacity (qt)</label>
                            <input type="number" step="0.1" name="oilCapacity" placeholder="e.g. 6" value="<%= spec && spec.oil && spec.oil.capacity ? spec.oil.capacity : '' %>">
                        </div>
                    </div>
                    <div class="field">
                        <label>Oil Tier Override</label>
                        <select name="oilTierOverride">
                            <option value="" <%= !(spec && spec.oilTierOverride) ? 'selected' : '' %>>None — use brand default tier</option>
                            <option value="budget" <%= (spec && spec.oilTierOverride === 'budget') ? 'selected' : '' %>>Force budget</option>
                            <option value="premium" <%= (spec && spec.oilTierOverride === 'premium') ? 'selected' : '' %>>Force premium (full synthetic)</option>
                        </select>
                        <div class="field-hint">Use this when a vehicle requires a specific oil tier regardless of the brand chosen.</div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">Filter & Drain</div>
                <div class="field-group">
                    <div class="field-row">
                        <div class="field">
                            <label>Filter Part Number</label>
                            <input type="text" name="filterPartNumber" placeholder="e.g. HP-1002" value="<%= spec && spec.filter && spec.filter.brandPartNumber ? spec.filter.brandPartNumber : '' %>">
                        </div>
                        <div class="field">
                            <label>Filter Socket</label>
                            <input type="text" name="filterSocket" placeholder="e.g. 74mm" value="<%= spec && spec.filter && spec.filter.socket ? spec.filter.socket : '' %>">
                        </div>
                    </div>
                    <div class="field-row">
                        <div class="field">
                            <label>Drain Plug</label>
                            <input type="text" name="drainPlug" placeholder="e.g. 15mm" value="<%= spec && spec.drainPlug ? spec.drainPlug : '' %>">
                        </div>
                        <div class="field">
                            <label>Tire Size</label>
                            <input type="text" name="tireSize" placeholder="e.g. 265/70R17" value="<%= spec && spec.tires && spec.tires.size ? spec.tires.size : '' %>">
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">Tools & Labor</div>
                <div class="field-group">
                    <div class="field">
                        <label>Tools (one per line)</label>
                        <textarea name="tools" placeholder="15mm Socket&#10;74mm Oil Filter Socket&#10;Drain Pan&#10;Torque Wrench"><%= spec && spec.tools && spec.tools.oilChange ? spec.tools.oilChange.join('\n') : '' %></textarea>
                    </div>
                    <div class="field">
                        <label>Labor Time (minutes)</label>
                        <input type="number" name="laborMinutes" placeholder="e.g. 20" value="<%= spec && spec.oilChangeLaborMinutes ? spec.oilChangeLaborMinutes : '' %>">
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">Notes</div>
                <div class="panel-sub">Why a labor time is what it is, access quirks, anything worth remembering for next time.</div>
                <div class="field-group">
                    <div class="field">
                        <textarea name="notes" placeholder="e.g. Filter is top-mounted and easily reached, single drain plug, no skid plate — quick oil change."><%= spec && spec.notes ? spec.notes : '' %></textarea>
                    </div>
                </div>
            </div>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary"><%= spec ? 'Save Changes' : 'Create Entry' %></button>
                <a href="/admin/site/specs" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <script>
        // Populate the model datalist based on the selected make, using the
        // same VEHICLE_DATA the booking page uses, passed from the server.
        var VEHICLE_DATA_FOR_FORM = <%- JSON.stringify(vehicleData) %>;

        var makeSelect = document.querySelector('select[name="make"]');
        var modelInput = document.querySelector('input[name="model"]');
        var modelDatalist = document.getElementById('model-options');

        if (makeSelect && modelDatalist) {
            makeSelect.addEventListener('change', function () {
                modelDatalist.innerHTML = '';
                var models = VEHICLE_DATA_FOR_FORM[makeSelect.value];
                if (!models) return;
                Object.keys(models).sort().forEach(function (model) {
                    var option = document.createElement('option');
                    option.value = model;
                    modelDatalist.appendChild(option);
                });
            });
        }
    </script>
</body>
</html>
