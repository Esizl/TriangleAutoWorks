<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <!--
        This page now reuses the same dark theme variables as booking.css /
        auth.css (--black, --card, --card2, --red, --silver, --border, etc.)
        instead of the old light glassmorphic palette, so it matches
        Settings/Login/Booking. If this page is ever loaded alongside
        booking.css directly, these :root values can be deleted in favor
        of the shared stylesheet — they're duplicated here only so this
        file still matches even if it's the only stylesheet loaded.
    -->
    <style>
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --red-soft: rgba(200, 16, 46, 0.1);
            --green: #4ADE80;
            --green-soft: rgba(74, 222, 128, 0.1);
            --amber: #E8B339;
            --amber-soft: rgba(232, 179, 57, 0.1);
            --blue: #4F9DFF;
            --blue-soft: rgba(79, 157, 255, 0.1);
            --radius: 4px;
            --font-display: 'Bebas Neue', sans-serif;
            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            -webkit-font-smoothing: antialiased;
        }

        body {
            font-family: var(--font-body);
            color: var(--white);
            min-height: 100vh;
            background: var(--black);
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0 40px;
            height: 64px;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
        }

        .topbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .topbar-brand-mark {
            width: 30px;
            height: 30px;
            border-radius: var(--radius);
            background: linear-gradient(135deg, var(--red), var(--red-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 800;
            box-shadow: 0 4px 14px rgba(200, 16, 46, 0.35);
            flex-shrink: 0;
        }

        .topbar-brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
            min-width: 0;
            overflow: hidden;
        }

        .topbar-brand-main {
            font-family: var(--font-display);
            font-size: 18px;
            letter-spacing: 0.04em;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .topbar-brand-sub {
            font-family: var(--font-body);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: var(--red);
            margin-top: 2px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .pill-link {
            display: flex;
            align-items: center;
            gap: 7px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 100px;
            padding: 9px 16px;
            font-size: 13px;
            font-weight: 600;
            color: var(--silver-dim);
            text-decoration: none;
            transition: border-color 0.2s, color 0.2s;
            white-space: nowrap;
        }

        .pill-link:hover {
            border-color: rgba(200, 16, 46, 0.4);
            color: var(--white);
        }

        .pill-link svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            flex-shrink: 0;
        }

        .shell {
            max-width: 1180px;
            margin: 0 auto;
            padding: 44px 40px 80px;
        }

        .greeting {
            font-family: var(--font-display);
            font-size: 40px;
            letter-spacing: 0.03em;
            margin-bottom: 6px;
        }

        .greeting-sub {
            font-size: 14px;
            color: var(--silver-dim);
            margin-bottom: 8px;
        }

        .red-rule {
            width: 48px;
            height: 3px;
            background: var(--red);
            margin-bottom: 36px;
        }

        /* ── CARD BASE ── */
        .dash-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        /* ── STATS ROW ── */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 32px;
        }

        .stat-card {
            padding: 22px 22px 20px;
        }

        .stat-icon-wrap {
            width: 34px;
            height: 34px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
        }

        .stat-icon-wrap svg {
            width: 17px;
            height: 17px;
        }

        .stat-card.tone-red .stat-icon-wrap {
            background: var(--red-soft);
        }

        .stat-card.tone-red .stat-icon-wrap svg {
            stroke: var(--red);
        }

        .stat-card.tone-green .stat-icon-wrap {
            background: var(--green-soft);
        }

        .stat-card.tone-green .stat-icon-wrap svg {
            stroke: var(--green);
        }

        .stat-card.tone-amber .stat-icon-wrap {
            background: var(--amber-soft);
        }

        .stat-card.tone-amber .stat-icon-wrap svg {
            stroke: var(--amber);
        }

        .stat-card.tone-blue .stat-icon-wrap {
            background: var(--blue-soft);
        }

        .stat-card.tone-blue .stat-icon-wrap svg {
            stroke: var(--blue);
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1;
            margin-bottom: 8px;
            color: var(--white);
        }

        .stat-label {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--silver-dim);
        }

        /* ── SECTION ── */
        .section-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--red);
            margin-bottom: 16px;
            padding-left: 2px;
        }

        /* ── TOOL TILES ── */
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            margin-bottom: 32px;
        }

        .tool-tile {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 26px;
            min-height: 168px;
            text-decoration: none;
            color: var(--white);
            transition: border-color 0.2s, transform 0.18s;
        }

        .tool-tile:hover {
            border-color: rgba(200, 16, 46, 0.4);
            transform: translateY(-2px);
        }

        .tool-tile-icon-wrap {
            width: 46px;
            height: 46px;
            border-radius: var(--radius);
            background: linear-gradient(135deg, var(--red), var(--red-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 18px rgba(200, 16, 46, 0.3);
        }

        .tool-tile-icon-wrap svg {
            width: 22px;
            height: 22px;
            stroke: white;
        }

        .tool-tile-name {
            font-family: var(--font-display);
            font-size: 20px;
            letter-spacing: 0.04em;
            margin-top: 18px;
            margin-bottom: 6px;
            color: var(--white);
        }

        .tool-tile-desc {
            font-size: 13px;
            color: var(--silver-dim);
            line-height: 1.4;
        }

        .tool-tile-badge {
            position: absolute;
            top: 22px;
            right: 22px;
            background: var(--red);
            color: white;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 100px;
        }

        @media (max-width: 900px) {

            .topbar,
            .shell {
                padding-left: 20px;
                padding-right: 20px;
            }

            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .tools-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 560px) {
            .stats-row {
                grid-template-columns: 1fr;
            }

            .tools-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ── MOBILE TOPBAR ── */
        @media (max-width: 480px) {
            .topbar {
                padding: 0 16px;
                height: 56px;
            }

            .topbar-brand-mark {
                width: 26px;
                height: 26px;
                font-size: 11px;
            }

            .topbar-brand-main {
                font-size: 15px;
            }

            .topbar-brand-sub {
                font-size: 8.5px;
                letter-spacing: 0.2em;
            }

            .topbar-actions {
                gap: 6px;
            }

            /* Collapse pill buttons to icon-only so they don't crowd
               the brand text on narrow screens */
            .pill-link {
                padding: 9px;
                gap: 0;
            }

            .pill-link-text {
                display: none;
            }

            .shell {
                padding-top: 28px;
            }

            .greeting {
                font-size: 32px;
            }
        }
    </style>
</head>

<body>
    <div class="topbar">
        <div class="topbar-brand">
            <div class="topbar-brand-mark">TA</div>
            <div class="topbar-brand-text">
                <div class="topbar-brand-main">Triangle Auto Works</div>
                <div class="topbar-brand-sub">Admin</div>
            </div>
        </div>
        <div class="topbar-actions">
            <a href="/settings" class="pill-link" aria-label="Settings">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path
                        d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
                <span class="pill-link-text">Settings</span>
            </a>
            <a href="/" class="pill-link" aria-label="Back to Site">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
                <span class="pill-link-text">Back to Site</span>
            </a>
        </div>
    </div>

    <div class="shell">
        <div class="greeting">
            <% const hour=new Date().getHours(); const greetingWord=hour < 12 ? 'Good morning' : hour < 18
                ? 'Good afternoon' : 'Good evening' ; %>
                <%= greetingWord %>.
        </div>
        <div class="greeting-sub">
            <%= new Date().toLocaleDateString('en-US', { weekday: 'long' , month: 'long' , day: 'numeric' }) %>
        </div>
        <div class="red-rule"></div>

        <div class="stats-row">
            <div class="dash-card stat-card tone-red">
                <div class="stat-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <div class="stat-value">
                    <%= stats.todaysBookings %>
                </div>
                <div class="stat-label">On the schedule today</div>
            </div>
            <div class="dash-card stat-card tone-green">
                <div class="stat-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23" />
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                </div>
                <div class="stat-value">$<%= stats.weekRevenue.toFixed(0) %>
                </div>
                <div class="stat-label">Confirmed revenue this week</div>
            </div>
            <div class="dash-card stat-card tone-amber">
                <div class="stat-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </div>
                <div class="stat-value">
                    <%= stats.pendingQuotes %>
                </div>
                <div class="stat-label">Pending quotes to follow up</div>
            </div>
            <div class="dash-card stat-card tone-blue">
                <div class="stat-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <div class="stat-value">
                    <%= stats.confirmed %>
                </div>
                <div class="stat-label">Confirmed appointments</div>
            </div>
        </div>

        <div class="section-label">Tools</div>
        <div class="tools-grid">
            <a href="/admin/bookings" class="dash-card tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                </div>
                <% if (stats.pendingQuotes> 0) { %>
                    <span class="tool-tile-badge">
                        <%= stats.pendingQuotes %> new
                    </span>
                    <% } %>
                        <div>
                            <div class="tool-tile-name">Bookings</div>
                            <div class="tool-tile-desc">View, manage, and update customer booking requests.</div>
                        </div>
            </a>

            <a href="/admin/users" class="dash-card tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-users-round-icon lucide-users-round">
                        <path d="M18 21a8 8 0 0 0-16 0" />
                        <circle cx="10" cy="8" r="5" />
                        <path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Users</div>
                    <div class="tool-tile-desc">Edit, View, Manage staff and customer accounts</div>
                </div>
            </a>

            <a href="/admin/site" class="dash-card tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path
                            d="M5 17h14a1 1 0 0 0 1-1v-4.5a1 1 0 0 0-.4-.8L16.5 8H15l-1.5-3H9L7.5 8H6.4a1 1 0 0 0-.8.4L3.4 11A1 1 0 0 0 3 11.8V16a1 1 0 0 0 1 1Z" />
                        <circle cx="7.5" cy="17" r="1.5" />
                        <circle cx="16.5" cy="17" r="1.5" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Site</div>
                    <div class="tool-tile-desc">Manage vehicle data, parts, and business settings.</div>
                </div>
            </a>
        </div>
    </div>
</body>

</html>