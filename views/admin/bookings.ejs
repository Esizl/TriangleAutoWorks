<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookings — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --red-soft: rgba(200, 16, 46, 0.12);
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --amber: #E8B339;
            --blue: #4F9DFF;
            --green: #4ADE80;
            --radius: 4px;
            --font-display: 'Bebas Neue', sans-serif;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }
        body {
            background: var(--black);
            color: var(--white);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title {
            font-family: var(--font-display);
            font-size: 19px;
            letter-spacing: 0.03em;
            color: var(--white);
        }
        .topbar-meta {
            font-size: 13px;
            color: var(--silver-dim);
        }
        .topbar-back {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--silver-dim);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: color 0.15s;
        }
        .topbar-back:hover { color: var(--white); }
        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }
        .topbar-center { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
        .topbar-spacer { width: 90px; flex-shrink: 0; }

        .shell {
            max-width: 1080px;
            margin: 0 auto;
            padding: 40px 32px 100px;
        }

        .page-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 28px;
        }
        .page-heading h1 {
            font-family: var(--font-display);
            font-size: 38px;
            letter-spacing: 0.03em;
            color: var(--white);
        }
        .page-heading .count {
            font-size: 14px;
            color: var(--silver-dim);
            font-weight: 500;
        }

        .filters {
            display: flex;
            gap: 6px;
            margin-bottom: 36px;
            flex-wrap: wrap;
        }
        .filters a {
            text-decoration: none;
            color: var(--silver-dim);
            font-size: 13px;
            font-weight: 500;
            padding: 6px 14px;
            border-radius: 100px;
            transition: background 0.15s, color 0.15s;
        }
        .filters a:hover { background: var(--card2); color: var(--white); }
        .filters a.active {
            background: var(--red);
            color: var(--white);
        }

        .group {
            margin-bottom: 36px;
        }
        .group-label {
            font-size: 11px;
            font-weight: 700;
            color: var(--red);
            text-transform: uppercase;
            letter-spacing: 0.15em;
            margin-bottom: 10px;
            padding-left: 4px;
        }

        .card-list {
            background: var(--card);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            overflow: hidden;
        }
        .booking-row {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 20px;
            text-decoration: none;
            color: var(--white);
            border-bottom: 1px solid var(--border);
            transition: background 0.12s;
        }
        .card-list .booking-row:last-child { border-bottom: none; }
        .booking-row:hover { background: var(--card2); }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .status-dot.new { background: var(--amber); }
        .status-dot.contacted { background: var(--blue); }
        .status-dot.confirmed { background: var(--green); }
        .status-dot.completed { background: var(--silver-dim); }
        .status-dot.cancelled { background: var(--red); opacity: 0.7; }

        .row-main {
            flex: 1;
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .row-customer {
            min-width: 150px;
        }
        .row-customer-name {
            font-weight: 600;
            font-size: 14.5px;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .row-customer-phone {
            font-size: 12.5px;
            color: var(--silver-dim);
        }
        .row-vehicle {
            flex: 1;
            min-width: 0;
            font-size: 14px;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .row-services {
            font-size: 13px;
            color: var(--silver-dim);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 220px;
            display: none;
        }
        .row-time {
            font-size: 13px;
            color: var(--text);
            text-align: right;
            min-width: 92px;
            flex-shrink: 0;
        }
        .row-total {
            font-size: 14px;
            font-weight: 600;
            color: var(--white);
            min-width: 64px;
            text-align: right;
            flex-shrink: 0;
        }
        .chevron {
            color: var(--silver-dim);
            flex-shrink: 0;
        }

        @media (min-width: 740px) {
            .row-services { display: block; }
        }

        .empty {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 64px 24px;
            text-align: center;
            color: var(--silver-dim);
            font-size: 14px;
        }

        a:focus-visible, .filters a:focus-visible {
            outline: 2px solid var(--blue);
            outline-offset: 2px;
        }

        /* ── MOBILE TOPBAR ──
           The title + date group and the balancing spacer were sized for
           desktop. On a phone, "Triangle Auto Works — Admin" plus the
           full date plus the back link no longer fit in one 60px-tall
           row, so we drop the spacer (it only existed to visually
           center the title against the back link), hide the date, and
           let the title truncate with an ellipsis instead of wrapping
           or overflowing. */
        @media (max-width: 480px) {
            .topbar {
                padding: 0 16px;
            }

            .topbar-spacer {
                display: none;
            }

            .topbar-center {
                flex: 1;
                justify-content: flex-end;
                overflow: hidden;
            }

            .topbar-title {
                font-size: 15px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .topbar-meta {
                display: none;
            }

            .shell {
                padding: 24px 16px 80px;
            }

            /* ── MOBILE BOOKING ROW ──
               The desktop row relies on fixed min-widths (row-customer
               alone floors at 150px) that add up to more than a phone
               screen has, so it would force horizontal crowding rather
               than wrapping. Re-lay the same elements into a 2-line
               grid instead: name + price on top, vehicle + time below.
               row-main is set to display:contents so its children
               (row-customer, row-vehicle) become direct grid items
               here instead of being trapped in their own flex row. */
            .booking-row {
                display: grid;
                grid-template-columns: auto 1fr auto;
                grid-template-areas:
                    "dot   name    total"
                    "dot   vehicle time";
                column-gap: 10px;
                row-gap: 4px;
                align-items: center;
                padding: 14px 16px;
            }

            .row-main {
                display: contents;
            }

            .status-dot {
                grid-area: dot;
                align-self: start;
                margin-top: 6px;
            }

            .row-customer {
                grid-area: name;
                min-width: 0;
            }

            .row-vehicle {
                grid-area: vehicle;
                font-size: 12.5px;
                min-width: 0;
            }

            .row-time {
                grid-area: time;
                text-align: left;
                font-size: 12px;
                min-width: 0;
            }

            .row-total {
                grid-area: total;
                min-width: 0;
            }

            .chevron {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/admin" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Dashboard
        </a>
        <div class="topbar-center">
            <div class="topbar-title">Triangle Auto Works — Admin</div>
            <div class="topbar-meta"><%= new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) %></div>
        </div>
        <div class="topbar-spacer"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Bookings</h1>
            <span class="count"><%= bookings.length %> total</span>
        </div>

        <% const statuses = ['all', 'new', 'contacted', 'confirmed', 'completed', 'cancelled']; %>
        <div class="filters">
            <% statuses.forEach(function(s) { %>
                <a href="<%= s === 'all' ? '/admin/bookings' : '/admin/bookings?status=' + s %>"
                   class="<%= currentStatus === s ? 'active' : '' %>">
                    <%= s.charAt(0).toUpperCase() + s.slice(1) %>
                </a>
            <% }); %>
        </div>

        <% if (!bookings || bookings.length === 0) { %>
            <div class="empty">No bookings match this filter yet.</div>
        <% } else { %>
            <%
                var todayStr = new Date().toISOString().split('T')[0];
                var today = new Date(todayStr + 'T00:00:00');
                var weekOut = new Date(today);
                weekOut.setDate(weekOut.getDate() + 7);

                var groups = { today: [], thisWeek: [], later: [], past: [] };
                bookings.forEach(function(b) {
                    if (!b.preferredDate) { groups.later.push(b); return; }
                    if (b.preferredDate === todayStr) { groups.today.push(b); return; }

                    var d = new Date(b.preferredDate + 'T00:00:00');
                    if (isNaN(d)) { groups.later.push(b); return; }
                    if (d < today) { groups.past.push(b); }
                    else if (d < weekOut) { groups.thisWeek.push(b); }
                    else { groups.later.push(b); }
                });
            %>

            <% function renderGroup(label, list) { %>
                <% if (list.length > 0) { %>
                    <div class="group">
                        <div class="group-label"><%= label %></div>
                        <div class="card-list">
                            <% list.forEach(function(b) { %>
                                <a class="booking-row" href="/admin/bookings/<%= b._id %>">
                                    <span class="status-dot <%= b.status %>"></span>
                                    <span class="row-main">
                                        <span class="row-customer">
                                            <div class="row-customer-name"><%= b.contact?.firstName %> <%= b.contact?.lastName %></div>
                                            <div class="row-customer-phone"><%= b.contact?.phone %></div>
                                        </span>
                                        <span class="row-vehicle">
                                            <% if (b.vehicle?.vinMode === 'manual') { %>
                                                <%= b.vehicle?.year %> <%= b.vehicle?.make %> <%= b.vehicle?.model %>
                                            <% } else { %>
                                                VIN <%= (b.vehicle?.vin || '').slice(-6) %>
                                            <% } %>
                                        </span>
                                        <span class="row-services"><%= (b.services || []).join(', ') %></span>
                                    </span>
                                    <span class="row-time">
                                        <%= b.preferredTime ? b.preferredTime.replace(/\s*\(.*?\)/, '') : '—' %>
                                    </span>
                                    <span class="row-total"><%= b.pricing?.total ? '$' + b.pricing.total.toFixed(0) : '—' %></span>
                                    <svg class="chevron" width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </a>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            <% } %>

            <% renderGroup('Today', groups.today); %>
            <% renderGroup('This week', groups.thisWeek); %>
            <% renderGroup('Later', groups.later); %>
            <% renderGroup('Past', groups.past); %>
        <% } %>
    </div>
</body>
</html>
