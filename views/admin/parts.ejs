<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parts Catalog — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FAFAFA;
            --surface: #FFFFFF;
            --ink: #1D1D1F;
            --ink-soft: #6E6E73;
            --ink-faint: #AEAEB2;
            --line: rgba(0, 0, 0, 0.07);
            --red: #C8102E;
            --red-soft: rgba(200, 16, 46, 0.08);
            --radius: 14px;
            --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(250, 250, 250, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-title { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }

        .topbar-back {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--ink-soft);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }

        .shell { max-width: 1000px; margin: 0 auto; padding: 40px 32px 100px; }

        .page-heading h1 { font-size: 30px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 8px; }
        .page-sub { font-size: 13.5px; color: var(--ink-soft); margin-bottom: 24px; }

        .tabs {
            display: flex;
            gap: 4px;
            border-bottom: 1px solid var(--line);
            margin-bottom: 20px;
            overflow-x: auto;
        }

        .tab {
            font-family: var(--font);
            font-size: 13.5px;
            font-weight: 600;
            color: var(--ink-soft);
            background: none;
            border: none;
            padding: 10px 16px;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            white-space: nowrap;
        }

        .tab.active { color: var(--ink); border-bottom-color: var(--red); }

        .toolbar { display: flex; justify-content: flex-end; margin-bottom: 16px; }

        .btn {
            font-family: var(--font);
            font-size: 14px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
        }

        .btn:hover { opacity: 0.85; }
        .btn-primary { background: var(--red); color: #fff; }
        .btn-secondary { background: var(--surface); color: var(--ink); border: 1px solid var(--line); }

        .table-wrap {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            overflow: hidden;
        }

        table { width: 100%; border-collapse: collapse; }

        th, td {
            text-align: left;
            padding: 12px 16px;
            font-size: 13.5px;
            border-bottom: 1px solid var(--line);
        }

        th {
            font-weight: 600;
            color: var(--ink-soft);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            background: rgba(0, 0, 0, 0.015);
        }

        tr:last-child td { border-bottom: none; }

        .row-actions { display: flex; gap: 8px; justify-content: flex-end; }

        .icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--ink-soft);
            padding: 4px;
            border-radius: 6px;
        }

        .icon-btn:hover { color: var(--ink); background: rgba(0,0,0,0.04); }
        .icon-btn svg { width: 16px; height: 16px; stroke: currentColor; }

        .empty-state { text-align: center; padding: 50px 24px; color: var(--ink-faint); font-size: 13.5px; }

        .error-banner {
            background: var(--red-soft);
            color: var(--red);
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 13.5px;
            font-weight: 600;
            margin-bottom: 16px;
            display: none;
        }

        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.35);
            z-index: 20;
            align-items: flex-start;
            justify-content: center;
            padding: 60px 20px;
            overflow-y: auto;
        }

        .modal-backdrop.open { display: flex; }

        .modal { background: var(--surface); border-radius: var(--radius); padding: 28px; width: 100%; max-width: 480px; }
        .modal h2 { font-size: 19px; font-weight: 700; margin-bottom: 20px; }

        .field { margin-bottom: 14px; }
        .field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--ink-soft); margin-bottom: 5px; }
        .field input, .field select { width: 100%; font-family: var(--font); font-size: 14px; padding: 9px 12px; border-radius: 8px; border: 1px solid var(--line); }
        .field-hint { font-size: 11.5px; color: var(--ink-faint); margin-top: 4px; }

        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }

        @media (max-width: 720px) {
            .shell { padding: 24px 16px 80px; }
            table thead { display: none; }
            table, tbody, tr, td { display: block; width: 100%; }
            tr { border-bottom: 1px solid var(--line); padding: 12px 16px; }
            td { border-bottom: none; padding: 4px 0; display: flex; justify-content: space-between; gap: 12px; }
            td::before { content: attr(data-label); font-weight: 600; color: var(--ink-soft); font-size: 12px; }
            .row-actions { justify-content: flex-end; }
        }
    </style>
</head>

<body>
    <div class="topbar">
        <a href="/admin/site" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Site
        </a>
        <div class="topbar-title">Parts Catalog</div>
        <div style="width:90px"></div>
    </div>

    <div class="shell">
        <div class="page-heading"><h1>Parts Catalog</h1></div>
        <div class="page-sub">Powers the booking configurator's oil, filter, brake, and tire pricing. Changes apply to new bookings immediately.</div>

        <div class="error-banner" id="errorBanner"></div>

        <div class="tabs" id="tabs">
            <button class="tab" data-section="oil-products">Oil Products</button>
            <button class="tab" data-section="filter-brands">Filter Brands</button>
            <button class="tab" data-section="filter-overrides">Filter Overrides</button>
            <button class="tab" data-section="brake-pads">Brake Pads</button>
            <button class="tab" data-section="rotors">Rotors</button>
            <button class="tab" data-section="tire-services">Tire Services</button>
            <button class="tab" data-section="suppliers">Suppliers</button>
        </div>

        <div class="toolbar">
            <button class="btn btn-primary" data-action="open-add-modal">+ Add</button>
        </div>

        <div class="table-wrap">
            <table id="itemsTable">
                <thead id="itemsHead"></thead>
                <tbody id="itemsBody"></tbody>
            </table>
            <div class="empty-state" id="emptyState" style="display:none;">No entries yet in this section.</div>
        </div>
    </div>

    <div class="modal-backdrop" id="modalBackdrop">
        <div class="modal">
            <h2 id="modalTitle">Add Entry</h2>
            <form id="itemForm">
                <input type="hidden" id="itemId">
                <div id="formFields"></div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" data-action="close-modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/parts-admin.js"></script>
</body>

</html>
