<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parts Catalog — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <div class="topbar">
        <a href="/admin/site" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Site
        </a>
        <div class="topbar-title">Parts Catalog</div>
        <div style="width:90px"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Parts Catalog</h1>
        </div>
        <div class="page-sub">Powers the booking configurator's oil, filter, brake, and tire pricing. Changes apply to
            new bookings immediately.</div>

        <div class="error-banner" id="errorBanner"></div>

        <div class="tabs" id="tabs">
            <button class="tab" data-section="oil-products">Oil Products</button>
            <button class="tab" data-section="filter-brands">Filter Brands</button>
            <button class="tab" data-section="filter-overrides">Filter Overrides</button>
            <button class="tab" data-section="brake-pads">Brake Pads</button>
            <button class="tab" data-section="rotors">Rotors</button>
            <button class="tab" data-section="tire-services">Tire Services</button>
            <button class="tab" data-section="suppliers">Suppliers</button>
        </div>

        <div class="toolbar">
            <button class="btn btn-primary" data-action="open-add-modal">+ Add</button>
        </div>

        <div class="table-wrap">
            <table id="itemsTable">
                <thead id="itemsHead"></thead>
                <tbody id="itemsBody"></tbody>
            </table>
            <div class="empty-state" id="emptyState" style="display:none;">No entries yet in this section.</div>
        </div>
    </div>

    <div class="modal-backdrop" id="modalBackdrop">
        <div class="modal">
            <h2 id="modalTitle">Add Entry</h2>
            <form id="itemForm">
                <input type="hidden" id="itemId">
                <div id="formFields"></div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" data-action="close-modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // @ts-nocheck
        window.VEHICLE_DATA = <%- JSON.stringify(vehicleData || {}) %>;
    </script>
    <script src="/js/parts-admin.js"></script>
</body>

</html>