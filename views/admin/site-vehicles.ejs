<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vehicle Data — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --red-soft: rgba(200, 16, 46, 0.12);
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --blue: #4F9DFF;
            --green: #4ADE80;
            --radius: 4px;
            --font-display: 'Bebas Neue', sans-serif;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }
        body {
            background: var(--black);
            color: var(--white);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title { font-family: var(--font-display); font-size: 19px; letter-spacing: 0.03em; color: var(--white); }
        .topbar-back {
            display: flex; align-items: center; gap: 6px;
            color: var(--silver-dim); text-decoration: none;
            font-size: 13px; font-weight: 600; transition: color 0.15s;
        }
        .topbar-back:hover { color: var(--white); }
        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }
        .topbar-center { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
        .topbar-spacer { width: 90px; flex-shrink: 0; }

        .shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 44px 32px 120px;
        }

        .page-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 6px;
        }
        .page-heading h1 {
            font-family: var(--font-display);
            font-size: 34px;
            letter-spacing: 0.03em;
            color: var(--white);
        }
        .page-heading .count {
            font-size: 14px;
            color: var(--silver-dim);
            font-weight: 500;
        }
        .page-sub {
            font-size: 13.5px;
            color: var(--silver-dim);
            margin-bottom: 28px;
        }

        .flash {
            padding: 13px 16px;
            border-radius: var(--radius);
            font-size: 13.5px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .flash-success { background: rgba(74,222,128,0.12); border: 1px solid rgba(74,222,128,0.3); color: var(--green); }
        .flash-error { background: var(--red-soft); border: 1px solid rgba(200,16,46,0.3); color: var(--red); }

        .accordion {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .make-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }

        .make-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 20px;
            cursor: pointer;
            user-select: none;
        }
        .make-header:hover { background: var(--card2); }
        .make-name {
            font-size: 15.5px;
            font-weight: 600;
            color: var(--white);
        }
        .make-meta {
            font-size: 12.5px;
            color: var(--silver-dim);
            font-weight: 500;
        }
        .make-header-left {
            display: flex;
            align-items: baseline;
            gap: 10px;
        }
        .chevron {
            color: var(--silver-dim);
            transition: transform 0.18s;
            flex-shrink: 0;
        }
        .make-card.open .chevron { transform: rotate(90deg); }

        .make-body {
            display: none;
            border-top: 1px solid var(--border);
            padding: 18px 20px 20px;
        }
        .make-card.open .make-body { display: block; }

        .model-row {
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
        }
        .model-row:last-of-type { border-bottom: none; }

        .model-row-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }
        .model-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--white);
        }

        .year-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 10px;
        }
        .year-chip {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--card2);
            border: 1px solid var(--border);
            border-radius: 100px;
            padding: 4px 6px 4px 11px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--white);
        }
        .year-chip-remove {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--silver-dim);
            cursor: pointer;
            font-size: 13px;
            line-height: 1;
            padding: 0;
        }
        .year-chip-remove:hover { background: var(--red-soft); color: var(--red); }
        .no-years {
            font-size: 12.5px;
            color: var(--silver-dim);
            font-style: italic;
        }

        .inline-form {
            display: flex;
            gap: 6px;
        }
        .inline-form input {
            font-family: var(--font);
            font-size: 13px;
            padding: 7px 10px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--card2);
            outline: none;
            width: 90px;
            color: var(--white);
        }
        .inline-form input:focus { border-color: var(--red); }
        .btn-mini {
            font-family: var(--font);
            font-size: 12.5px;
            font-weight: 600;
            padding: 7px 13px;
            border-radius: var(--radius);
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--card2);
            color: var(--white);
            white-space: nowrap;
        }
        .btn-mini:hover { background: #262626; }
        .btn-mini-danger {
            border-color: rgba(200,16,46,0.3);
            color: var(--red);
            background: var(--red-soft);
        }
        .btn-mini-danger:hover { background: rgba(200,16,46,0.2); }

        .add-model-row {
            display: flex;
            gap: 6px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--border);
        }
        .add-model-row input {
            flex: 1;
            font-family: var(--font);
            font-size: 13.5px;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--card2);
            outline: none;
            color: var(--white);
        }
        .add-model-row input:focus { border-color: var(--red); }
        .btn-add-model {
            font-family: var(--font);
            font-size: 13px;
            font-weight: 600;
            padding: 9px 16px;
            border-radius: var(--radius);
            cursor: pointer;
            border: none;
            background: var(--red);
            color: var(--white);
            white-space: nowrap;
        }
        .btn-add-model:hover { background: var(--red-dark); }

        /* ── MOBILE ── */
        @media (max-width: 480px) {
            .topbar { padding: 0 16px; }
            .topbar-spacer { display: none; }
            .topbar-center { flex: 1; justify-content: flex-end; overflow: hidden; }
            .topbar-title { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .shell { padding: 24px 16px 80px; }
            .make-body { padding: 16px; }
            .inline-form { flex-wrap: wrap; }
            .inline-form input { width: 100%; }
            .add-model-row { flex-direction: column; }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/admin/site" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Site
        </a>
        <div class="topbar-center">
            <div class="topbar-title">Triangle Auto Works — Admin</div>
        </div>
        <div class="topbar-spacer"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Vehicle Data</h1>
            <span class="count"><%= Object.keys(vehicleData).length %> makes</span>
        </div>
        <div class="page-sub">Models and model years available in the booking form. Makes are fixed — add or remove models and years as new vehicles come out.</div>

        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length) { %>
            <% successMessage.forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
            <% }) %>
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length) { %>
            <% errorMessage.forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
            <% }) %>
        <% } %>

        <div class="accordion">
            <% Object.keys(vehicleData).sort().forEach(function(make) { %>
                <% const models = vehicleData[make]; %>
                <% const modelCount = Object.keys(models).length; %>
                <div class="make-card" data-make="<%= make %>">
                    <div class="make-header" onclick="this.closest('.make-card').classList.toggle('open')">
                        <div class="make-header-left">
                            <span class="make-name"><%= make %></span>
                            <span class="make-meta"><%= modelCount %> model<%= modelCount === 1 ? '' : 's' %></span>
                        </div>
                        <svg class="chevron" width="8" height="14" viewBox="0 0 8 14" fill="none"><path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div class="make-body">
                        <% Object.keys(models).sort().forEach(function(model) { %>
                            <% const years = models[model]; %>
                            <% const deleteModelMsg = 'Remove ' + model + ' from ' + make + '? This will also remove all its model years.'; %>
                            <div class="model-row">
                                <div class="model-row-header">
                                    <span class="model-name"><%= model %></span>
                                    <form method="POST" action="/admin/site/vehicles/model/delete" class="confirm-form" data-confirm="<%= deleteModelMsg %>">
                                        <input type="hidden" name="make" value="<%= make %>">
                                        <input type="hidden" name="model" value="<%= model %>">
                                        <button type="submit" class="btn-mini btn-mini-danger">Remove model</button>
                                    </form>
                                </div>
                                <div class="year-chips">
                                    <% if (years.length === 0) { %>
                                        <span class="no-years">No years added yet</span>
                                    <% } %>
                                    <% years.slice().sort(function(a,b){ return b - a; }).forEach(function(year) { %>
                                        <span class="year-chip">
                                            <%= year %>
                                            <form method="POST" action="/admin/site/vehicles/year/delete" style="display:inline;">
                                                <input type="hidden" name="make" value="<%= make %>">
                                                <input type="hidden" name="model" value="<%= model %>">
                                                <input type="hidden" name="year" value="<%= year %>">
                                                <button type="submit" class="year-chip-remove" aria-label="Remove <%= year %>">&times;</button>
                                            </form>
                                        </span>
                                    <% }); %>
                                </div>
                                <form method="POST" action="/admin/site/vehicles/year" class="inline-form">
                                    <input type="hidden" name="make" value="<%= make %>">
                                    <input type="hidden" name="model" value="<%= model %>">
                                    <input type="number" name="year" placeholder="e.g. 2026" min="1900" max="2100" required>
                                    <button type="submit" class="btn-mini">Add year</button>
                                </form>
                            </div>
                        <% }); %>

                        <form method="POST" action="/admin/site/vehicles/model" class="add-model-row">
                            <input type="hidden" name="make" value="<%= make %>">
                            <input type="text" name="model" placeholder="Add a new model…" required>
                            <button type="submit" class="btn-add-model">Add model</button>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <script>
        document.querySelectorAll('.confirm-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                var message = form.getAttribute('data-confirm');
                if (message && !window.confirm(message)) {
                    e.preventDefault();
                }
            });
        });
    </script>
</body>
</html>
