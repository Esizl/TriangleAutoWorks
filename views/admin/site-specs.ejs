<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vehicle Specs — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FAFAFA;
            --surface: #FFFFFF;
            --ink: #1D1D1F;
            --ink-soft: #6E6E73;
            --ink-faint: #AEAEB2;
            --line: rgba(0,0,0,0.07);
            --red: #C8102E;
            --red-soft: rgba(200,16,46,0.08);
            --blue: #0071E3;
            --green: #1E8E5A;
            --amber: #B8800A;
            --amber-soft: rgba(232,179,57,0.16);
            --radius: 14px;
            --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }
        body {
            background: var(--bg);
            color: var(--ink);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(250,250,250,0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
        .topbar-back {
            display: flex; align-items: center; gap: 6px;
            color: var(--ink-soft); text-decoration: none;
            font-size: 13px; font-weight: 600; transition: color 0.15s;
        }
        .topbar-back:hover { color: var(--ink); }
        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }

        .shell {
            max-width: 820px;
            margin: 0 auto;
            padding: 40px 32px 100px;
        }

        .page-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 8px;
        }
        .page-heading h1 {
            font-size: 30px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        .page-sub {
            font-size: 13.5px;
            color: var(--ink-soft);
            margin-bottom: 24px;
        }

        .btn-new {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font);
            font-size: 13.5px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: 10px;
            background: var(--ink);
            color: var(--surface);
            text-decoration: none;
            white-space: nowrap;
        }
        .btn-new:hover { opacity: 0.85; }

        .flash {
            padding: 13px 16px;
            border-radius: 10px;
            font-size: 13.5px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .flash-success { background: rgba(30,142,90,0.08); border: 1px solid rgba(30,142,90,0.25); color: var(--green); }
        .flash-error { background: rgba(200,16,46,0.08); border: 1px solid rgba(200,16,46,0.25); color: var(--red); }

        .card-list {
            background: var(--surface);
            border-radius: var(--radius);
            border: 1px solid var(--line);
            overflow: hidden;
        }
        .spec-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--line);
        }
        .card-list .spec-row:last-child { border-bottom: none; }
        .spec-row:hover { background: rgba(0,0,0,0.015); }

        .spec-main {
            flex: 1;
            min-width: 0;
        }
        .spec-title {
            font-size: 14.5px;
            font-weight: 600;
        }
        .spec-sub {
            font-size: 12.5px;
            color: var(--ink-faint);
            margin-top: 2px;
        }

        .year-badge {
            font-size: 11.5px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 100px;
            white-space: nowrap;
        }
        .year-badge.default { background: var(--blue-soft, rgba(0,113,227,0.1)); color: var(--blue); }
        .year-badge.override { background: var(--amber-soft); color: var(--amber); }

        .row-actions {
            display: flex;
            gap: 8px;
            flex-shrink: 0;
        }
        .btn-mini {
            font-family: var(--font);
            font-size: 12.5px;
            font-weight: 600;
            padding: 7px 13px;
            border-radius: 8px;
            cursor: pointer;
            border: 1px solid var(--line);
            background: var(--surface);
            color: var(--ink);
            text-decoration: none;
            white-space: nowrap;
        }
        .btn-mini:hover { background: rgba(0,0,0,0.03); }
        .btn-mini-danger {
            border-color: rgba(200,16,46,0.2);
            color: var(--red);
            background: var(--red-soft);
        }
        .btn-mini-danger:hover { background: rgba(200,16,46,0.14); }

        .empty {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 64px 24px;
            text-align: center;
            color: var(--ink-soft);
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/admin/site" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Site
        </a>
        <div class="topbar-title">Triangle Auto Works — Admin</div>
        <div style="width:90px"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Vehicle Specs</h1>
            <a href="/admin/site/specs/new" class="btn-new">+ New entry</a>
        </div>
        <div class="page-sub">Oil capacity, filter specs, tools, and labor time per vehicle. Owner-only — these specs guide real repair jobs.</div>

        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length) { %>
            <% successMessage.forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
            <% }) %>
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length) { %>
            <% errorMessage.forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
            <% }) %>
        <% } %>

        <% if (!specs || specs.length === 0) { %>
            <div class="empty">No spec entries yet. Add one to get started.</div>
        <% } else { %>
            <div class="card-list">
                <% specs.forEach(function(s) { %>
                    <% const deleteMsg = 'Delete the spec entry for ' + s.make + ' ' + s.model + (s.year ? ' ' + s.year : ' (model default)') + '? This cannot be undone.'; %>
                    <div class="spec-row">
                        <span class="spec-main">
                            <div class="spec-title"><%= s.make %> <%= s.model %></div>
                            <div class="spec-sub">
                                <%= s.oil && s.oil.viscosity ? s.oil.viscosity : 'No oil spec' %><% if (s.oil && s.oil.capacity) { %> · <%= s.oil.capacity %>qt<% } %><% if (s.oilChangeLaborMinutes) { %> · <%= s.oilChangeLaborMinutes %> min labor<% } %>
                            </div>
                        </span>
                        <span class="year-badge <%= s.year ? 'override' : 'default' %>">
                            <%= s.year ? s.year : 'Model default' %>
                        </span>
                        <span class="row-actions">
                            <a href="/admin/site/specs/<%= s._id %>/edit" class="btn-mini">Edit</a>
                            <form method="POST" action="/admin/site/specs/<%= s._id %>/delete" class="confirm-form" data-confirm="<%= deleteMsg %>">
                                <button type="submit" class="btn-mini btn-mini-danger">Delete</button>
                            </form>
                        </span>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <script>
        document.querySelectorAll('.confirm-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                var message = form.getAttribute('data-confirm');
                if (message && !window.confirm(message)) {
                    e.preventDefault();
                }
            });
        });
    </script>
</body>
</html>
