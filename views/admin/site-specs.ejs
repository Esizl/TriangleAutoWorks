<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vehicle Specs — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --red-soft: rgba(200, 16, 46, 0.12);
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --amber: #E8B339;
            --amber-soft: rgba(232, 179, 57, 0.12);
            --blue: #4F9DFF;
            --blue-soft: rgba(79, 157, 255, 0.12);
            --green: #4ADE80;
            --radius: 4px;
            --font-display: 'Bebas Neue', sans-serif;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }
        body {
            background: var(--black);
            color: var(--white);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title { font-family: var(--font-display); font-size: 19px; letter-spacing: 0.03em; color: var(--white); }
        .topbar-back {
            display: flex; align-items: center; gap: 6px;
            color: var(--silver-dim); text-decoration: none;
            font-size: 13px; font-weight: 600; transition: color 0.15s;
        }
        .topbar-back:hover { color: var(--white); }
        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }
        .topbar-center { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
        .topbar-spacer { width: 90px; flex-shrink: 0; }

        .shell {
            max-width: 820px;
            margin: 0 auto;
            padding: 44px 32px 120px;
        }

        .page-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 6px;
        }
        .page-heading h1 {
            font-family: var(--font-display);
            font-size: 34px;
            letter-spacing: 0.03em;
            color: var(--white);
        }
        .page-sub {
            font-size: 13.5px;
            color: var(--silver-dim);
            margin-bottom: 24px;
        }

        .btn-new {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font);
            font-size: 13.5px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: var(--radius);
            background: var(--red);
            color: var(--white);
            text-decoration: none;
            white-space: nowrap;
        }
        .btn-new:hover { background: var(--red-dark); }

        .flash {
            padding: 13px 16px;
            border-radius: var(--radius);
            font-size: 13.5px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .flash-success { background: rgba(74,222,128,0.12); border: 1px solid rgba(74,222,128,0.3); color: var(--green); }
        .flash-error { background: var(--red-soft); border: 1px solid rgba(200,16,46,0.3); color: var(--red); }

        .card-list {
            background: var(--card);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            overflow: hidden;
        }
        .spec-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
        }
        .card-list .spec-row:last-child { border-bottom: none; }
        .spec-row:hover { background: var(--card2); }

        .spec-main {
            flex: 1;
            min-width: 0;
        }
        .spec-title {
            font-size: 14.5px;
            font-weight: 600;
            color: var(--white);
        }
        .spec-sub {
            font-size: 12.5px;
            color: var(--silver-dim);
            margin-top: 2px;
        }

        .year-badge {
            font-size: 11.5px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 100px;
            white-space: nowrap;
        }
        .year-badge.default { background: var(--blue-soft); color: var(--blue); }
        .year-badge.override { background: var(--amber-soft); color: var(--amber); }
        .year-badge.unverified { background: var(--red-soft); color: var(--red); }

        .row-actions {
            display: flex;
            gap: 8px;
            flex-shrink: 0;
        }
        .btn-mini {
            font-family: var(--font);
            font-size: 12.5px;
            font-weight: 600;
            padding: 7px 13px;
            border-radius: var(--radius);
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--card2);
            color: var(--white);
            text-decoration: none;
            white-space: nowrap;
        }
        .btn-mini:hover { background: #262626; }
        .btn-mini-danger {
            border-color: rgba(200,16,46,0.3);
            color: var(--red);
            background: var(--red-soft);
        }
        .btn-mini-danger:hover { background: rgba(200,16,46,0.2); }

        .empty {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 64px 24px;
            text-align: center;
            color: var(--silver-dim);
            font-size: 14px;
        }

        /* ── MOBILE ── */
        @media (max-width: 480px) {
            .topbar { padding: 0 16px; }
            .topbar-spacer { display: none; }
            .topbar-center { flex: 1; justify-content: flex-end; overflow: hidden; }
            .topbar-title { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .shell { padding: 24px 16px 80px; }
            .page-heading { flex-wrap: wrap; gap: 10px; }
            .spec-row { flex-wrap: wrap; }
            .spec-main { flex-basis: 100%; }
            .row-actions { flex-basis: 100%; justify-content: flex-end; }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/admin/site" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Site
        </a>
        <div class="topbar-center">
            <div class="topbar-title">Triangle Auto Works — Admin</div>
        </div>
        <div class="topbar-spacer"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Vehicle Specs</h1>
            <a href="/admin/site/specs/new" class="btn-new">+ New entry</a>
        </div>
        <div class="page-sub">Oil capacity, filter specs, tools, and labor time per vehicle. Owner-only — these specs guide real repair jobs. Entries marked Unverified are starting figures: quotes built from them still show as estimated until you open the entry, check it, and save.</div>

        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length) { %>
            <% successMessage.forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
            <% }) %>
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length) { %>
            <% errorMessage.forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
            <% }) %>
        <% } %>

        <% if (!specs || specs.length === 0) { %>
            <div class="empty">No spec entries yet. Add one to get started.</div>
        <% } else { %>
            <div class="card-list">
                <% specs.forEach(function(s) { %>
                    <% const deleteMsg = 'Delete the spec entry for ' + s.make + ' ' + s.model + (s.year ? ' ' + s.year + (s.yearEnd ? '–' + s.yearEnd : '') : ' (model default)') + '? This cannot be undone.'; %>
                    <div class="spec-row">
                        <span class="spec-main">
                            <div class="spec-title"><%= s.make %> <%= s.model %></div>
                            <div class="spec-sub">
                                <%= s.oil && s.oil.viscosity ? s.oil.viscosity : 'No oil spec' %><% if (s.oil && s.oil.capacity) { %> · <%= s.oil.capacity %>qt<% } %><% if (s.oilChangeLaborMinutes) { %> · <%= s.oilChangeLaborMinutes %> min labor<% } %>
                            </div>
                        </span>
                        <span class="year-badge <%= s.year ? 'override' : 'default' %>">
                            <%= s.year ? (s.yearEnd ? s.year + '–' + s.yearEnd : s.year) : 'Model default' %>
                        </span>
                        <% if (s.verified === false) { %>
                            <span class="year-badge unverified">Unverified</span>
                        <% } %>
                        <span class="row-actions">
                            <a href="/admin/site/specs/<%= s._id %>/edit" class="btn-mini">Edit</a>
                            <form method="POST" action="/admin/site/specs/<%= s._id %>/delete" class="confirm-form" data-confirm="<%= deleteMsg %>">
                                <button type="submit" class="btn-mini btn-mini-danger">Delete</button>
                            </form>
                        </span>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <script>
        document.querySelectorAll('.confirm-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                var message = form.getAttribute('data-confirm');
                if (message && !window.confirm(message)) {
                    e.preventDefault();
                }
            });
        });
    </script>
</body>
</html>
