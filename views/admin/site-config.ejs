<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Config — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --red-soft: rgba(200, 16, 46, 0.12);
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --blue: #4F9DFF;
            --green: #4ADE80;
            --radius: 4px;
            --font-display: 'Bebas Neue', sans-serif;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }
        body {
            background: var(--black);
            color: var(--white);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title { font-family: var(--font-display); font-size: 19px; letter-spacing: 0.03em; color: var(--white); }
        .topbar-back {
            display: flex; align-items: center; gap: 6px;
            color: var(--silver-dim); text-decoration: none;
            font-size: 13px; font-weight: 600; transition: color 0.15s;
        }
        .topbar-back:hover { color: var(--white); }
        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }
        .topbar-center { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
        .topbar-spacer { width: 90px; flex-shrink: 0; }

        .shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 44px 32px 120px;
        }

        .page-heading h1 {
            font-family: var(--font-display);
            font-size: 34px;
            letter-spacing: 0.03em;
            color: var(--white);
            margin-bottom: 6px;
        }
        .page-sub {
            font-size: 13.5px;
            color: var(--silver-dim);
            margin-bottom: 28px;
        }

        .flash {
            padding: 13px 16px;
            border-radius: var(--radius);
            font-size: 13.5px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .flash-success { background: rgba(74,222,128,0.12); border: 1px solid rgba(74,222,128,0.3); color: var(--green); }
        .flash-error { background: var(--red-soft); border: 1px solid rgba(200,16,46,0.3); color: var(--red); }

        .config-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
        }

        .config-field {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 24px;
            padding: 18px 0;
            border-bottom: 1px solid var(--border);
        }
        .config-field:first-child { padding-top: 0; }
        .config-field:last-of-type { border-bottom: none; }

        .config-field-info { flex: 1; }
        .config-field-name {
            font-size: 14.5px;
            font-weight: 600;
            color: var(--white);
            margin-bottom: 3px;
        }
        .config-field-desc {
            font-size: 12.5px;
            color: var(--silver-dim);
            line-height: 1.5;
        }

        .config-input-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .config-input-prefix,
        .config-input-suffix {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--silver-dim);
        }
        .config-input-wrap input {
            font-family: var(--font);
            font-size: 14px;
            font-weight: 600;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--card2);
            outline: none;
            width: 110px;
            text-align: right;
            color: var(--white);
        }
        .config-input-wrap input:focus { border-color: var(--red); }

        .config-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .config-updated {
            font-size: 12.5px;
            color: var(--silver-dim);
            font-weight: 500;
        }
        .btn-primary {
            font-family: var(--font);
            font-size: 13px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: var(--radius);
            cursor: pointer;
            border: none;
            background: var(--red);
            color: var(--white);
        }
        .btn-primary:hover { background: var(--red-dark); }

        /* ── MOBILE ── */
        @media (max-width: 480px) {
            .topbar { padding: 0 16px; }
            .topbar-spacer { display: none; }
            .topbar-center { flex: 1; justify-content: flex-end; overflow: hidden; }
            .topbar-title { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .shell { padding: 24px 16px 80px; }
            .config-card { padding: 18px; }
            .config-field { flex-direction: column; align-items: stretch; gap: 12px; }
            .config-input-wrap { justify-content: flex-start; }
            .config-actions { flex-direction: column-reverse; align-items: stretch; }
            .config-actions .btn-primary { width: 100%; text-align: center; }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/admin/site" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Site
        </a>
        <div class="topbar-center">
            <div class="topbar-title">Triangle Auto Works — Admin</div>
        </div>
        <div class="topbar-spacer"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Business Config</h1>
        </div>
        <div class="page-sub">Rates and limits used across the booking flow. Changes take effect immediately. Owner-only.</div>

        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length) { %>
            <% successMessage.forEach(function(msg) { %>
                <div class="flash flash-success"><%= msg %></div>
            <% }) %>
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length) { %>
            <% errorMessage.forEach(function(msg) { %>
                <div class="flash flash-error"><%= msg %></div>
            <% }) %>
        <% } %>

        <form method="POST" action="/admin/site/config">
            <div class="config-card">
                <div class="config-field">
                    <div class="config-field-info">
                        <div class="config-field-name">Labor rate</div>
                        <div class="config-field-desc">Hourly labor rate for Automotive labor lines on the booking form (oil change, brakes, tires).</div>
                    </div>
                    <div class="config-input-wrap">
                        <span class="config-input-prefix">$</span>
                        <input type="number" name="laborRatePerHour" value="<%= config.laborRatePerHour %>" min="0" step="0.01" required>
                        <span class="config-input-suffix">/hr</span>
                    </div>
                </div>

                <div class="config-field">
                    <div class="config-field-info">
                        <div class="config-field-name">Standalone diagnostic fee</div>
                        <div class="config-field-desc">Trip charge when a diagnostic is booked on its own. Free when bundled with a repair.</div>
                    </div>
                    <div class="config-input-wrap">
                        <span class="config-input-prefix">$</span>
                        <input type="number" name="diagnosticStandaloneFee" value="<%= config.diagnosticStandaloneFee %>" min="0" step="0.01" required>
                    </div>
                </div>

                <div class="config-field">
                    <div class="config-field-info">
                        <div class="config-field-name">Sales tax</div>
                        <div class="config-field-desc">Charged on every estimate (after any discount). Shown to customers on the tax line.</div>
                    </div>
                    <div class="config-input-wrap">
                        <input type="number" name="taxRatePercent" value="<%= config.taxRatePercent %>" min="0" max="25" step="0.001" required>
                        <span class="config-input-suffix">%</span>
                    </div>
                </div>

                <div class="config-field">
                    <div class="config-field-info">
                        <div class="config-field-name">Booking capacity per time window</div>
                        <div class="config-field-desc">How many confirmed jobs can overlap the same time window. 1 means one job at a time. A long job uses every window it runs into.</div>
                    </div>
                    <div class="config-input-wrap">
                        <input type="number" name="bookingCapacityPerWindow" value="<%= config.bookingCapacityPerWindow %>" min="1" step="1" required>
                        <span class="config-input-suffix">bookings</span>
                    </div>
                </div>
            </div>

            <div class="config-card" style="margin-top:20px">
                <div class="config-field">
                    <div class="config-field-info">
                        <div class="config-field-name">Drop-off address</div>
                        <div class="config-field-desc">Where approved customers bring their vehicle for the cheaper drop-off price. Only they see it — on the booking form and in their emails. Leave empty to turn drop-off off for everyone.</div>
                    </div>
                    <div class="config-input-wrap" style="flex:1;max-width:340px">
                        <input type="text" name="dropOffAddress" value="<%= config.dropOffAddress || '' %>" placeholder="Street, city, zip" style="width:100%">
                    </div>
                </div>

                <div class="config-field">
                    <div class="config-field-info">
                        <div class="config-field-name">Drop-off directions</div>
                        <div class="config-field-desc">Optional. Shown under the address, e.g. "Park in the driveway, keys in the lockbox."</div>
                    </div>
                    <div class="config-input-wrap" style="flex:1;max-width:340px">
                        <input type="text" name="dropOffNotes" value="<%= config.dropOffNotes || '' %>" placeholder="Optional" style="width:100%">
                    </div>
                </div>

                <div class="config-field">
                    <div class="config-field-info">
                        <div class="config-field-name">Drop-off discount</div>
                        <div class="config-field-desc">How much cheaper it is when they bring it to you. Comes off before any discount code and before tax. Approve customers under Trusted Customers.</div>
                    </div>
                    <div class="config-input-wrap">
                        <input type="number" name="dropOffDiscountValue" value="<%= config.dropOffDiscountValue %>" min="0" step="0.01" required>
                        <select name="dropOffDiscountType" style="margin-left:8px">
                            <option value="percent" <%= config.dropOffDiscountType !== 'fixed' ? 'selected' : '' %>>% off</option>
                            <option value="fixed" <%= config.dropOffDiscountType === 'fixed' ? 'selected' : '' %>>$ off</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="config-actions">
                <span class="config-updated">Last saved: <%= config.updatedAt ? config.updatedAt.toLocaleString('en-US') : 'never' %></span>
                <button type="submit" class="btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</body>
</html>
