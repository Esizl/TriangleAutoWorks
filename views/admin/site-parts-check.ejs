<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parts &amp; Tools Check — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --red-soft: rgba(200, 16, 46, 0.12);
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --amber: #E8B339;
            --amber-soft: rgba(232, 179, 57, 0.12);
            --blue: #4F9DFF;
            --blue-soft: rgba(79, 157, 255, 0.12);
            --green: #4ADE80;
            --radius: 4px;
            --font-display: 'Bebas Neue', sans-serif;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-font-smoothing: antialiased; }
        body {
            background: var(--black);
            color: var(--white);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .topbar-title { font-family: var(--font-display); font-size: 19px; letter-spacing: 0.03em; color: var(--white); }
        .topbar-back {
            display: flex; align-items: center; gap: 6px;
            color: var(--silver-dim); text-decoration: none;
            font-size: 13px; font-weight: 600; transition: color 0.15s;
        }
        .topbar-back:hover { color: var(--white); }
        .topbar-back svg { width: 13px; height: 13px; stroke: currentColor; }
        .topbar-center { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
        .topbar-spacer { width: 90px; flex-shrink: 0; }

        .shell {
            max-width: 820px;
            margin: 0 auto;
            padding: 44px 32px 120px;
        }

        .page-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 6px;
        }
        .page-heading h1 {
            font-family: var(--font-display);
            font-size: 34px;
            letter-spacing: 0.03em;
            color: var(--white);
        }
        .page-sub {
            font-size: 13.5px;
            color: var(--silver-dim);
            margin-bottom: 24px;
        }

        .btn-new {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font);
            font-size: 13.5px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: var(--radius);
            background: var(--red);
            color: var(--white);
            text-decoration: none;
            white-space: nowrap;
        }
        .btn-new:hover { background: var(--red-dark); }

        .flash {
            padding: 13px 16px;
            border-radius: var(--radius);
            font-size: 13.5px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .flash-success { background: rgba(74,222,128,0.12); border: 1px solid rgba(74,222,128,0.3); color: var(--green); }
        .flash-error { background: var(--red-soft); border: 1px solid rgba(200,16,46,0.3); color: var(--red); }

        .card-list {
            background: var(--card);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            overflow: hidden;
        }
        .spec-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
        }
        .card-list .spec-row:last-child { border-bottom: none; }
        .spec-row:hover { background: var(--card2); }

        .spec-main {
            flex: 1;
            min-width: 0;
        }
        .spec-title {
            font-size: 14.5px;
            font-weight: 600;
            color: var(--white);
        }
        .spec-sub {
            font-size: 12.5px;
            color: var(--silver-dim);
            margin-top: 2px;
        }

        .year-badge {
            font-size: 11.5px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 100px;
            white-space: nowrap;
        }
        .year-badge.default { background: var(--blue-soft); color: var(--blue); }
        .year-badge.override { background: var(--amber-soft); color: var(--amber); }
        .year-badge.unverified { background: var(--red-soft); color: var(--red); }

        .row-actions {
            display: flex;
            gap: 8px;
            flex-shrink: 0;
        }
        .btn-mini {
            font-family: var(--font);
            font-size: 12.5px;
            font-weight: 600;
            padding: 7px 13px;
            border-radius: var(--radius);
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--card2);
            color: var(--white);
            text-decoration: none;
            white-space: nowrap;
        }
        .btn-mini:hover { background: #262626; }
        .btn-mini-danger {
            border-color: rgba(200,16,46,0.3);
            color: var(--red);
            background: var(--red-soft);
        }
        .btn-mini-danger:hover { background: rgba(200,16,46,0.2); }

        .empty {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 64px 24px;
            text-align: center;
            color: var(--silver-dim);
            font-size: 14px;
        }

        /* ── MOBILE ── */
        @media (max-width: 480px) {
            .topbar { padding: 0 16px; }
            .topbar-spacer { display: none; }
            .topbar-center { flex: 1; justify-content: flex-end; overflow: hidden; }
            .topbar-title { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .shell { padding: 24px 16px 80px; }
            .page-heading { flex-wrap: wrap; gap: 10px; }
            .spec-row { flex-wrap: wrap; }
            .spec-main { flex-basis: 100%; }
            .row-actions { flex-basis: 100%; justify-content: flex-end; }
        }
    
        .section-label {
            font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
            color: var(--silver-dim); margin: 32px 0 10px;
        }
        .add-form { display: flex; gap: 8px; flex-wrap: wrap; padding: 16px 20px; border-bottom: 1px solid var(--border); }
        .add-form input {
            background: var(--card2); border: 1px solid var(--border); border-radius: var(--radius);
            color: var(--white); font-family: var(--font); font-size: 13.5px; padding: 9px 12px; min-width: 0;
        }
        .add-form input[name="phone"] { width: 150px; }
        .add-form input[name="name"] { width: 160px; }
        .add-form input[name="note"] { flex: 1; min-width: 140px; }
        .row-empty { padding: 16px 20px; font-size: 13px; color: var(--silver-dim); }
        .count-badge { font-size: 11.5px; font-weight: 700; padding: 3px 9px; border-radius: 100px; background: var(--amber-soft); color: var(--amber); white-space: nowrap; }
        form.inline { display: inline; }
    
        .shell { max-width: 960px; }
        .issue { display: flex; gap: 12px; padding: 11px 20px; border-bottom: 1px solid var(--border); font-size: 13.5px; }
        .card-list .issue:last-child { border-bottom: none; }
        .issue-area { flex: 0 0 120px; color: var(--silver-dim); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; padding-top: 1px; }
        .issue.problem .issue-msg::before { content: '●'; color: var(--red); margin-right: 8px; }
        .issue.note .issue-msg::before { content: '●'; color: var(--amber); margin-right: 8px; }
        .check-form { display: flex; gap: 8px; flex-wrap: wrap; padding: 16px 20px; }
        .check-form select, .check-form input {
            background: var(--card2); border: 1px solid var(--border); border-radius: var(--radius);
            color: var(--white); font-family: var(--font); font-size: 13.5px; padding: 9px 12px;
        }
        .check-form input[name="year"] { width: 90px; }
        table.parts { width: 100%; border-collapse: collapse; font-size: 13px; }
        table.parts th { text-align: left; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--silver-dim); font-weight: 600; padding: 10px 20px; border-bottom: 1px solid var(--border); }
        table.parts td { padding: 10px 20px; border-bottom: 1px solid var(--border); vertical-align: top; }
        table.parts tr:last-child td { border-bottom: none; }
        .fit-vehicle { color: var(--green); }
        .fit-default { color: var(--amber); }
        .fit-none { color: var(--red); }
        .muted { color: var(--silver-dim); }
        .kv { padding: 14px 20px; font-size: 13.5px; line-height: 1.8; }
        .kv b { color: var(--silver-dim); font-weight: 600; display: inline-block; min-width: 130px; }
        .chip { display: inline-block; font-size: 12px; padding: 3px 9px; margin: 2px 4px 2px 0; border-radius: 100px; background: var(--card2); border: 1px solid var(--border); }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="/admin/site" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Site
        </a>
        <div class="topbar-center">
            <div class="topbar-title">Triangle Auto Works — Admin</div>
        </div>
        <div class="topbar-spacer"></div>
    </div>

    <%
        const FIT = {
            vehicle: ['fit-vehicle', 'for this vehicle'],
            default: ['fit-default', 'default — check fit'],
            none: ['fit-none', 'none on file'],
            product: ['muted', ''],
            missing: ['fit-none', 'not in catalog']
        };
        function part(p) {
            if (!p) return '';
            const fit = FIT[p.fitment] || FIT.none;
            return (p.partNumber || '—') + (fit[1] ? ' · ' + fit[1] : '');
        }
        const problems = issues.filter(i => i.severity === 'problem');
        const notes = issues.filter(i => i.severity === 'note');
    %>

    <div class="shell">
        <div class="page-heading">
            <h1>Parts &amp; Tools Check</h1>
        </div>
        <div class="page-sub">Checks the parts catalog and vehicle specs for anything that would put a missing or wrong part number, or the wrong tools, on a tech sheet. Pick a vehicle below to see exactly what its oil change tech sheet would show. Nothing here changes any data.</div>

        <div class="section-label">Check a vehicle</div>
        <div class="card-list">
            <form method="GET" action="/admin/site/parts-check" class="check-form" id="checkForm">
                <select name="make" id="checkMake" required>
                    <option value="">Make…</option>
                    <% Object.keys(vehicleData).sort().forEach(function(mk) { %>
                        <option value="<%= mk %>" <%= query.make === mk ? 'selected' : '' %>><%= mk %></option>
                    <% }) %>
                </select>
                <select name="model" id="checkModel" required data-selected="<%= query.model %>">
                    <option value="">Model…</option>
                </select>
                <input type="number" name="year" placeholder="Year" min="1980" max="2100" value="<%= query.year %>">
                <button type="submit" class="btn-new">Check</button>
            </form>
            <% if (inspectError) { %><div class="issue problem"><span class="issue-msg"><%= inspectError %></span></div><% } %>
        </div>

        <% if (inspection) { const sp = inspection.specs; %>
            <div class="section-label"><%= query.year %> <%= query.make %> <%= query.model %> — oil change</div>
            <div class="card-list">
                <div class="kv">
                    <% if (inspection.blocked && inspection.blocked.blocked) { %>
                        <div class="fit-none">Oil changes are blocked for this vehicle: <%= inspection.blocked.reason %></div>
                    <% } %>
                    <div><b>Spec used</b>
                        <% if (inspection.specEntry) { %>
                            <%= inspection.specEntry.year == null ? 'Model default' : (inspection.specEntry.yearEnd ? inspection.specEntry.year + '–' + inspection.specEntry.yearEnd : inspection.specEntry.year) %>
                            <%= inspection.specEntry.verified === false ? '(Unverified)' : '' %>
                            · <a href="/admin/site/specs/<%= inspection.specEntry._id %>/edit" style="color:var(--silver)">edit</a>
                        <% } else { %>
                            <span class="fit-default">None — generic estimate (5 qt, 5W-30)</span> · <a href="/admin/site/specs/new" style="color:var(--silver)">add one</a>
                        <% } %>
                    </div>
                    <div><b>Oil</b><%= sp.oil && sp.oil.capacity %> qt · <%= sp.oil && sp.oil.viscosity %><%= sp.oilTierOverride === 'premium' ? ' · synthetic required' : '' %></div>
                    <div><b>Drain plug</b><%= sp.drainPlug || '—' %> &nbsp; <b style="min-width:0">Filter socket</b> <%= (sp.filter && sp.filter.socket) || '—' %></div>
                    <div><b>Labor</b><%= sp.oilChangeLaborMinutes ? sp.oilChangeLaborMinutes + ' min' : '20 min (default — none set on the spec)' %></div>
                    <div><b>Tools on the sheet</b><% inspection.tools.forEach(function(t) { %><span class="chip"><%= t %></span><% }) %></div>
                </div>
            </div>

            <div class="section-label">Filters for this vehicle</div>
            <div class="card-list">
                <table class="parts">
                    <tr><th>Brand</th><th>Oil filter</th><th>Engine air filter</th><th>Cabin air filter</th></tr>
                    <% inspection.filters.forEach(function(f) { %>
                        <tr>
                            <td><%= f.brand %></td>
                            <% ['oil', 'engine', 'cabin'].forEach(function(t) { const p = f[t]; %>
                                <td class="<%= (FIT[p.fitment] || FIT.none)[0] %>"><%= part(p) %><% if (p.price != null) { %><br><span class="muted">$<%= Number(p.price).toFixed(2) %><%= t !== 'oil' && p.fitment === 'none' ? ' (oil filter price — placeholder)' : '' %></span><% } %></td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </table>
            </div>

            <div class="section-label">Oils offered (<%= sp.oil && sp.oil.viscosity %>)</div>
            <div class="card-list">
                <table class="parts">
                    <tr><th>Oil</th><th>Offered on</th><th>5qt jug</th><th>Quart</th></tr>
                    <% const offered = {}; inspection.budgetOils.forEach(o => { offered[o.name] = { o, on: ['Oil Change'] } }); inspection.premiumOils.forEach(o => { (offered[o.name] = offered[o.name] || { o, on: [] }).on.push('Premium Oil Change') }); %>
                    <% if (Object.keys(offered).length === 0) { %>
                        <tr><td colspan="4" class="fit-none">No oils in the catalog are listed for <%= sp.oil && sp.oil.viscosity %> — this vehicle can't be quoted an oil change. Add one in the Parts Catalog, or check its Available Viscosities.</td></tr>
                    <% } %>
                    <% Object.values(offered).forEach(function(x) { %>
                        <tr>
                            <td><%= x.o.name %></td>
                            <td class="muted"><%= x.on.join(', ') %></td>
                            <td class="<%= x.o.jugPartNumber ? '' : 'fit-none' %>"><%= x.o.jugPartNumber || 'no part #' %><% if (x.o.jugPrice != null) { %><br><span class="muted">$<%= Number(x.o.jugPrice).toFixed(2) %></span><% } %></td>
                            <td class="<%= x.o.quartPartNumber ? '' : 'fit-none' %>"><%= x.o.quartPartNumber || 'no part #' %><% if (x.o.price != null) { %><br><span class="muted">$<%= Number(x.o.price).toFixed(2) %></span><% } %></td>
                        </tr>
                    <% }) %>
                </table>
            </div>
        <% } %>

        <div class="section-label">Problems (<%= problems.length %>) — these show wrong or missing info on real jobs</div>
        <div class="card-list">
            <% if (problems.length === 0) { %><div class="row-empty">None found.</div><% } %>
            <% problems.forEach(function(i) { %>
                <div class="issue problem"><span class="issue-area"><%= i.area %></span><span class="issue-msg"><%= i.message %></span></div>
            <% }) %>
        </div>

        <div class="section-label">Worth a look (<%= notes.length %>)</div>
        <div class="card-list">
            <% if (notes.length === 0) { %><div class="row-empty">Nothing.</div><% } %>
            <% notes.forEach(function(i) { %>
                <div class="issue note"><span class="issue-area"><%= i.area %></span><span class="issue-msg"><%= i.message %></span></div>
            <% }) %>
        </div>
    </div>

    <script>
        // Model list follows the chosen make (same data the booking form uses).
        var VEHICLE_DATA_FOR_FORM = <%- JSON.stringify(vehicleData).replace(/</g, '\\u003c') %>;
        (function () {
            var makeSel = document.getElementById('checkMake');
            var modelSel = document.getElementById('checkModel');
            function fill() {
                var models = Object.keys(VEHICLE_DATA_FOR_FORM[makeSel.value] || {}).sort();
                var wanted = modelSel.dataset.selected;
                modelSel.innerHTML = '<option value="">Model…</option>' + models.map(function (m) {
                    var esc = m.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
                    return '<option value="' + esc + '"' + (m === wanted ? ' selected' : '') + '>' + esc + '</option>';
                }).join('');
            }
            makeSel.addEventListener('change', function () { modelSel.dataset.selected = ''; fill(); });
            fill();
        })();
    </script>
</body>
</html>
