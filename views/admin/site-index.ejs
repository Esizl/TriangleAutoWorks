<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Site — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #FAFAFA;
            --surface: #FFFFFF;
            --ink: #1D1D1F;
            --ink-soft: #6E6E73;
            --ink-faint: #AEAEB2;
            --line: rgba(0, 0, 0, 0.07);
            --red: #C8102E;
            --red-soft: rgba(200, 16, 46, 0.08);
            --radius: 14px;
            --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            -webkit-font-smoothing: antialiased;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(250, 250, 250, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-title {
            font-size: 17px;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .topbar-back {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--ink-soft);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: color 0.15s;
        }

        .topbar-back:hover {
            color: var(--ink);
        }

        .topbar-back svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 40px 32px 100px;
        }

        .page-heading h1 {
            font-size: 30px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }

        .page-sub {
            font-size: 13.5px;
            color: var(--ink-soft);
            margin-bottom: 28px;
        }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .tool-tile {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px;
            min-height: 140px;
            text-decoration: none;
            color: var(--ink);
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            transition: transform 0.18s, box-shadow 0.18s;
        }

        .tool-tile:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(31, 38, 71, 0.08);
        }

        .tool-tile-icon-wrap {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--red-soft);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tool-tile-icon-wrap svg {
            width: 19px;
            height: 19px;
            stroke: var(--red);
        }

        .tool-tile-name {
            font-size: 16px;
            font-weight: 700;
            margin-top: 14px;
            margin-bottom: 3px;
        }

        .tool-tile-desc {
            font-size: 12.5px;
            color: var(--ink-soft);
            line-height: 1.4;
        }

        .tool-tile-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 140px;
            padding: 24px;
            border: 1.5px dashed var(--line);
            border-radius: var(--radius);
            color: var(--ink-faint);
            font-size: 13px;
            font-weight: 600;
            background: rgba(0, 0, 0, 0.015);
        }

        @media (max-width: 560px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="topbar">
        <a href="/admin" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Dashboard
        </a>
        <div class="topbar-title">Triangle Auto Works — Admin</div>
        <div style="width:90px"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Site</h1>
        </div>
        <div class="page-sub">Manage the data that powers the booking form and repair workflows.</div>

        <div class="tools-grid">
            <a href="/admin/site/vehicles" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path
                            d="M5 17h14a1 1 0 0 0 1-1v-4.5a1 1 0 0 0-.4-.8L16.5 8H15l-1.5-3H9L7.5 8H6.4a1 1 0 0 0-.8.4L3.4 11A1 1 0 0 0 3 11.8V16a1 1 0 0 0 1 1Z" />
                        <circle cx="7.5" cy="17" r="1.5" />
                        <circle cx="16.5" cy="17" r="1.5" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Vehicle Data</div>
                    <div class="tool-tile-desc">Makes, models, and model years for the booking form.</div>
                </div>
            </a>

            <a href="/admin/site/specs" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path
                            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Vehicle Specs</div>
                    <div class="tool-tile-desc">Oil capacity, filters, tools, and labor time. Owner-only.</div>
                </div>
            </a>

            <div class="tool-tile-placeholder">Parts Catalog — coming soon</div>
            <a href="/admin/site/blocklist" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <line x1="5.6" y1="5.6" x2="18.4" y2="18.4" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Oil Change Blocklist</div>
                    <div class="tool-tile-desc">Makes and models where standard oil changes are disabled.</div>
                </div>
            </a>
            <a href="/admin/site/config" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="4" y1="21" x2="4" y2="14" />
                        <line x1="4" y1="10" x2="4" y2="3" />
                        <line x1="12" y1="21" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12" y2="3" />
                        <line x1="20" y1="21" x2="20" y2="16" />
                        <line x1="20" y1="12" x2="20" y2="3" />
                        <line x1="1" y1="14" x2="7" y2="14" />
                        <line x1="9" y1="8" x2="15" y2="8" />
                        <line x1="17" y1="16" x2="23" y2="16" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Business Config</div>
                    <div class="tool-tile-desc">Labor rate, diagnostic fee, and booking capacity. Owner-only.</div>
                </div>
            </a>
        </div>
    </div>
</body>

</html>