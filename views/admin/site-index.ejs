<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Site — Triangle Auto Works</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --black: #0A0A0A;
            --card: #141414;
            --card2: #1C1C1C;
            --red: #C8102E;
            --red-dark: #9E0C24;
            --red-soft: rgba(200, 16, 46, 0.12);
            --silver: #C0C0C0;
            --silver-dim: #7A7A7A;
            --white: #F5F5F5;
            --text: #CCCCCC;
            --border: rgba(255, 255, 255, 0.07);
            --radius: 4px;
            --font-display: 'Bebas Neue', sans-serif;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            -webkit-font-smoothing: antialiased;
        }

        body {
            background: var(--black);
            color: var(--white);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.45;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(200, 16, 46, 0.25);
            padding: 0 32px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-title {
            font-family: var(--font-display);
            font-size: 19px;
            letter-spacing: 0.03em;
            color: var(--white);
        }

        .topbar-back {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--silver-dim);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: color 0.15s;
        }

        .topbar-back:hover {
            color: var(--white);
        }

        .topbar-back svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
        }

        .topbar-center { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
        .topbar-spacer { width: 90px; flex-shrink: 0; }

        .shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 44px 32px 120px;
        }

        .page-heading h1 {
            font-family: var(--font-display);
            font-size: 38px;
            letter-spacing: 0.03em;
            color: var(--white);
            margin-bottom: 6px;
        }

        .page-sub {
            font-size: 13.5px;
            color: var(--silver-dim);
            margin-bottom: 32px;
        }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .tool-tile {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 24px;
            min-height: 140px;
            text-decoration: none;
            color: var(--white);
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            transition: border-color 0.15s, background 0.15s;
        }

        .tool-tile:hover {
            background: var(--card2);
            border-color: rgba(200, 16, 46, 0.3);
        }

        .tool-tile-icon-wrap {
            width: 40px;
            height: 40px;
            border-radius: var(--radius);
            background: var(--red-soft);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tool-tile-icon-wrap svg {
            width: 19px;
            height: 19px;
            stroke: var(--red);
        }

        .tool-tile-name {
            font-size: 16px;
            font-weight: 700;
            color: var(--white);
            margin-top: 14px;
            margin-bottom: 3px;
        }

        .tool-tile-desc {
            font-size: 12.5px;
            color: var(--silver-dim);
            line-height: 1.4;
        }

        .tool-tile-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            min-height: 140px;
            padding: 24px;
            border: 1.5px dashed var(--border);
            border-radius: var(--radius);
            color: var(--silver-dim);
            font-size: 13px;
            font-weight: 600;
            background: var(--card);
        }

        a:focus-visible {
            outline: 2px solid var(--blue, #4F9DFF);
            outline-offset: 2px;
        }

        /* ── MOBILE ──
           Same topbar pattern as the rest of admin: no spacer, title
           shrinks and truncates instead of wrapping. Tiles already
           collapse to one column below 560px; just tighten shell
           padding to match the other admin pages at phone width. */
        @media (max-width: 480px) {
            .topbar {
                padding: 0 16px;
            }

            .topbar-spacer {
                display: none;
            }

            .topbar-center {
                flex: 1;
                justify-content: flex-end;
                overflow: hidden;
            }

            .topbar-title {
                font-size: 15px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .shell {
                padding: 24px 16px 80px;
            }
        }

        @media (max-width: 560px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="topbar">
        <a href="/admin" class="topbar-back">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Dashboard
        </a>
        <div class="topbar-center">
            <div class="topbar-title">Triangle Auto Works — Admin</div>
        </div>
        <div class="topbar-spacer"></div>
    </div>

    <div class="shell">
        <div class="page-heading">
            <h1>Site</h1>
        </div>
        <div class="page-sub">Manage the data that powers the booking form and repair workflows.</div>

        <div class="tools-grid">
            <a href="/admin/site/vehicles" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path
                            d="M5 17h14a1 1 0 0 0 1-1v-4.5a1 1 0 0 0-.4-.8L16.5 8H15l-1.5-3H9L7.5 8H6.4a1 1 0 0 0-.8.4L3.4 11A1 1 0 0 0 3 11.8V16a1 1 0 0 0 1 1Z" />
                        <circle cx="7.5" cy="17" r="1.5" />
                        <circle cx="16.5" cy="17" r="1.5" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Vehicle Data</div>
                    <div class="tool-tile-desc">Makes, models, and model years for the booking form.</div>
                </div>
            </a>

            <a href="/admin/site/specs" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path
                            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Vehicle Specs</div>
                    <div class="tool-tile-desc">Oil capacity, filters, tools, and labor time. Owner-only.</div>
                </div>
            </a>

            <a href="/admin/site/parts" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path
                            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Parts Catalog</div>
                    <div class="tool-tile-desc">Oil, filter, brake, and tire pricing for the booking configurator.
                        Owner-only.</div>
                </div>
            </a>

            <a href="/admin/site/blocklist" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <line x1="5.6" y1="5.6" x2="18.4" y2="18.4" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Oil Change Blocklist</div>
                    <div class="tool-tile-desc">Makes and models where standard oil changes are disabled.</div>
                </div>
            </a>
            <a href="/admin/site/config" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="4" y1="21" x2="4" y2="14" />
                        <line x1="4" y1="10" x2="4" y2="3" />
                        <line x1="12" y1="21" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12" y2="3" />
                        <line x1="20" y1="21" x2="20" y2="16" />
                        <line x1="20" y1="12" x2="20" y2="3" />
                        <line x1="1" y1="14" x2="7" y2="14" />
                        <line x1="9" y1="8" x2="15" y2="8" />
                        <line x1="17" y1="16" x2="23" y2="16" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Business Config</div>
                    <div class="tool-tile-desc">Labor rate, tax, diagnostic fee, booking capacity and drop-off. Owner-only.</div>
                </div>
            </a>
            <a href="/admin/site/discounts" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <line x1="19" y1="5" x2="5" y2="19" />
                        <circle cx="6.5" cy="6.5" r="2.5" />
                        <circle cx="17.5" cy="17.5" r="2.5" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Discount Codes</div>
                    <div class="tool-tile-desc">Create and manage codes customers enter at booking. Owner-only.</div>
                </div>
            </a>

            <a href="/admin/reviews" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Reviews</div>
                    <div class="tool-tile-desc">Approve customer reviews before they show on the home page. Owner-only.</div>
                </div>
            </a>

            <a href="/admin/site/trusted" class="tool-tile">
                <div class="tool-tile-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M12 2l3 6.5 7 .8-5.2 4.8 1.4 7L12 17.6 5.8 21l1.4-7L2 9.3l7-.8z" />
                    </svg>
                </div>
                <div>
                    <div class="tool-tile-name">Trusted Customers</div>
                    <div class="tool-tile-desc">Approve regulars and friends to bring their vehicle to you for less. Owner-only.</div>
                </div>
            </a>
        </div>
    </div>
</body>

</html>
