    <!-- REVIEWS (approved customer reviews; hidden until there is at least one) -->
    <% if (reviewSummary.count > 0) { %>
    <section id="reviews" class="reviews">
        <div class="section-label">Customer Reviews</div>
        <h2 class="section-title">What Customers Say</h2>
        <div class="reviews-summary">
            <span class="reviews-average"><%= reviewSummary.average.toFixed(1) %></span>
            <span class="review-stars" role="img" aria-label="<%= reviewSummary.average.toFixed(1) %> out of 5 stars"><% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= Math.round(reviewSummary.average) ? '' : 'off' %>">★</span><% } %></span>
            <span class="reviews-count"><%= reviewSummary.count %> review<%= reviewSummary.count === 1 ? '' : 's' %> from booked customers</span>
        </div>
        <div class="reviews-grid">
            <% reviewSummary.reviews.forEach(function(r) { %>
                <div class="review-card">
                    <div class="review-stars" role="img" aria-label="<%= r.rating %> out of 5 stars"><% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= r.rating ? '' : 'off' %>">★</span><% } %></div>
                    <p class="review-card-text"><%= r.text %></p>
                    <div class="review-card-name"><%= r.displayName %></div>
                    <div class="review-card-meta"><%= (r.services || []).join(', ') %><%= r.vehicle ? ' · ' + r.vehicle : '' %></div>
                </div>
            <% }) %>
        </div>
    </section>
    <% } %>

    <!-- MOBILE CALLOUT -->
    <div id="mobile" class="mobile-callout">
        <div>
            <div class="section-label">Mobile Service</div>
            <h2 class="mobile-callout-headline">
                We Come
                <span>To You.</span>
            </h2>
            <p class="mobile-callout-body">
                No drop-off, no wait rooms. We bring professional detailing, tinting, and maintenance
                directly to your
                home, apartment, or office — anywhere in the Raleigh area.
            </p>
            <a href="/booking" class="btn-primary">Schedule a Mobile Visit</a>
        </div>
        <div class="callout-details">
            <div class="callout-detail">
                <div class="callout-detail-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                </div>
                <div class="callout-detail-text">
                    <strong>Home</strong>
                    We work in your driveway or parking spot.
                </div>
            </div>
            <div class="callout-detail">
                <div class="callout-detail-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" />
                        <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" />
                    </svg>
                </div>
                <div class="callout-detail-text">
                    <strong>Office</strong>
                    Get your car done while you work.
                </div>
            </div>
            <div class="callout-detail">
                <div class="callout-detail-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </div>
                <div class="callout-detail-text">
                    <strong>On Your Schedule</strong>
                    Book by call, text, or DM on Instagram.
                </div>
            </div>
            <div class="callout-detail">
                <div class="callout-detail-icon">
