                    <circle cx="35" cy="38" r="4" />
                    <path d="M4 28 Q24 22 44 28" />
                </svg>
                <div class="service-col-title">Detailing</div>
                <ul class="service-list">
                    <li>Basic Wash</li>
                    <li>Basic Detail</li>
                    <li>Interior Detail</li>
                    <li>Exterior Detail</li>
                    <li>Full Detail</li>
                    <li>Ceramic Coatings</li>
                    <li>Paint Decontamination</li>
                </ul>
            </div>
            <!-- Tint -->
            <div class="service-col">
