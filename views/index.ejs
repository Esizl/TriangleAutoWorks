    <!-- FOOTER CTA -->
    <div class="footer-cta">
        <div class="section-label">Ready?</div>
        <h2 class="footer-cta-title">Book Your Service</h2>
        <p class="footer-cta-sub">Call · Text · DM — We're ready when you are.</p>
