<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Triangle Auto Works — Detailing · Tint · Automotive Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/reviews.css">
</head>

<body>

    <!-- NAV -->
    <nav>
        <a href="" class="nav-logo">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="20,2 38,36 2,36" fill="none" stroke="#C8102E" stroke-width="2.5" />
                <text x="20" y="32" text-anchor="middle" font-family="'Bebas Neue',sans-serif" font-size="18"
                    fill="#C0C0C0">TA</text>
            </svg>
            <div class="nav-wordmark">
                Triangle
                <span>Auto Works</span>
            </div>
        </a>
        <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-label="Open menu">
            <span></span><span></span><span></span>
        </button>
        <ul class="nav-links">
            <li><a href="#services">Services</a></li>
            <li><a href="#pricing">Pricing</a></li>
            <li><a href="#bundles">Packages</a></li>
            <% if (reviewSummary.count > 0) { %>
                <li><a href="#reviews">Reviews</a></li>
            <% } %>
            <% if (user) { %>
                <li class="nav-account" id="navAccount">
                    <button class="nav-account-trigger" onclick="toggleAccountMenu(event)">
                        <span class="nav-account-avatar">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </span>
                        <%= user.name.split(' ')[0] %>
                        <svg class="nav-account-chevron" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>
                    <div class="nav-account-menu">
                        <div class="nav-account-name"><%= user.name %></div>
                        <div class="nav-account-email"><%= user.email %></div>
                        <a href="/account/orders">Order History</a>
                        <a href="/settings">Settings</a>
                        <% if (user.role >= 2) { %>
                            <a href="/admin">Admin Dashboard</a>
                        <% } %>
                        <a href="/auth/logout" class="nav-account-logout">Logout</a>
                    </div>
                </li>
            <% } else { %>
                <li><a href="/login">Login</a></li>
            <% } %>
            <li><a href="/booking" class="nav-cta">Book Now</a></li>
            <!-- <li><a href="tel:7326478703" class="nav-cta">Call Now</a></li> -->
        </ul>
    </nav>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-bg"></div>
        <!-- SVG abstract car outline -->
        <svg class="hero-car" viewBox="0 0 780 300" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path
                d="M40 220 Q80 220 120 180 L200 100 Q240 60 320 50 L520 45 Q620 45 680 100 L740 160 Q760 180 760 210 L760 225 L40 225 Z"
                stroke="#C0C0C0" stroke-width="1.5" fill="none" />
            <ellipse cx="180" cy="228" rx="45" ry="20" stroke="#C0C0C0" stroke-width="1.5" fill="none" />
            <ellipse cx="600" cy="228" rx="45" ry="20" stroke="#C0C0C0" stroke-width="1.5" fill="none" />
            <path d="M200 100 L210 60 L490 55 L520 45" stroke="#C0C0C0" stroke-width="1" fill="none" />
            <path d="M120 175 L380 170 L500 165 L680 175" stroke="#C0C0C0" stroke-width="0.75" fill="none"
                opacity="0.5" />
            <line x1="380" y1="50" x2="380" y2="170" stroke="#C0C0C0" stroke-width="0.5" opacity="0.3" />
            <path d="M280 60 Q310 40 360 38 L420 38 Q470 40 490 55" stroke="#C8102E" stroke-width="1" fill="none"
                opacity="0.6" />
        </svg>

        <div class="hero-eyebrow">Raleigh, NC · Mobile Service Available</div>
        <div class="hero-rule"></div>
        <h1 class="hero-headline">
            Cleaner.<br>
            Sharper.<br>
            <em>Better.</em>
        </h1>
        <p class="hero-sub">Detailing &nbsp;·&nbsp; <strong>Tint</strong> &nbsp;·&nbsp; Automotive Services</p>
        <div class="hero-actions">
            <a href="/booking" class="btn-primary">
                Book Now
            </a>
            <a href="#services" class="btn-ghost">View Services</a>
        </div>

        <div class="hero-info">
            <div class="hero-stat">
                <div class="hero-stat-val">3<span>+</span></div>
                <div class="hero-stat-label">Service Categories</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-val">$50<span>+</span></div>
                <div class="hero-stat-label">Starting Price</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-val">5<span>✦</span></div>
                <div class="hero-stat-label">First-Timer Specials</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-val">WE COME<span> TO YOU</span></div>
                <div class="hero-stat-label">Mobile · Home · Office</div>
            </div>
        </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="services">
        <div class="section-label">What We Do</div>
        <h2 class="section-title">One Stop.<br>Every Vehicle.</h2>
        <div class="red-rule"></div>
        <div class="services-grid">
            <!-- Detailing -->
            <div class="service-col">
